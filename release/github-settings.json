{
  "_comment": "The GitHub settings that protect a release (release/README.md, \"Repository settings\"). scripts/check-github-settings.sh compares the live ones with this file. Rulesets are matched by name; ids and timestamps are left out.",
  "repository": "dmarcelino/lollo-rozzo",
  "immutable_releases": true,
  "rulesets": [
    {
      "name": "Main branch",
      "target": "branch",
      "enforcement": "active",
      "include": ["~DEFAULT_BRANCH"],
      "rules": ["deletion", "non_fast_forward", "required_status_checks"],
      "required_checks": ["ci-passed"],
      "bypass": [{ "actor_type": "RepositoryRole", "actor_id": 5, "bypass_mode": "always" }]
    },
    {
      "name": "Release tags",
      "target": "tag",
      "enforcement": "active",
      "include": ["refs/tags/v*"],
      "rules": ["creation", "deletion", "update"],
      "required_checks": [],
      "bypass": [{ "actor_type": "RepositoryRole", "actor_id": 5, "bypass_mode": "always" }]
    },
    {
      "name": "Hotfix branches",
      "target": "branch",
      "enforcement": "active",
      "include": ["refs/heads/hotfix/*"],
      "rules": ["deletion", "non_fast_forward", "required_status_checks"],
      "required_checks": ["ci-passed"],
      "bypass": [{ "actor_type": "RepositoryRole", "actor_id": 5, "bypass_mode": "always" }]
    }
  ]
}
