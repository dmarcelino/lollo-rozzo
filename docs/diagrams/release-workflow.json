  "cards": [
    {
      "dot": "cyan",
      "title": "Named by content",
      "items": [
        "a lollo image's tag hashes its build context, its shared context, its name and REBUILD",
        "an unchanged image keeps its name and digest, so its container is not recreated and a vault stays unlocked",
        "each platform builds on a runner of its own architecture, never under emulation"
      ]
    },
    {
      "dot": "amber",
      "title": "Built on the admin's host, never published",
      "items": [
        "doc-tools (AGPL-3.0 PyMuPDF) and the code editor's shell (FROM the app-server's image)",
        "both build contexts ship inside the lolloctl image"
      ]
    },
    {
      "dot": "rose",
      "title": "Nothing moves after a release",
      "items": [
        "no latest and nothing from main without a tag: the wrapper names the lolloctl image by digest",
        "the notes start with release/NOTES.md's highlights, then list the images that changed, so which containers restart and whether vaults lock",
        "after a final release, the release skill sets VERSION to the next minor and deletes release/NOTES.md"
      ]
    },
    {
      "dot": "violet",
      "title": "Dev builds",
      "items": [
        "a pull request from this repository, Renovate's excepted, or a run by hand on any branch but main",
        "the same images, plus one lolloctl tag vX.Y.Z-dev.<slug>.<N>: no git tag, no GitHub release",
        "self-upgrade pulls that image, pins its digest and fills in the wrapper template it carries"
      ]
    }
  ]
