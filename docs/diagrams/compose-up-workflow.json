  "cards": [
    {
      "dot": "cyan",
      "title": "Compose files, in order",
      "items": [
        "upstream/docker/compose.yml, then hardening, multi, vault, gmail-triggers, news-radar, pipelock, code-server, outlook, browser, notifications, landing",
        "doc-tools.yml only with lollo-doc-tools, pipelock-proxy.yml last and only with lollo-pipelock",
        "-p lollo-<name>, --project-directory upstream/docker, --env-file stack.env"
      ]
    },
    {
      "dot": "cyan",
      "title": "What is built here",
      "items": [
        "upstream's images, when Lettuce publishes none for this host (LETTA_IMAGE_NS empty)",
        "from a clone every lollo image; in release mode only the code editor's shell, named by RELEASE otherwise",
        "then up never builds: a published image that is missing fails"
      ]
    },
    {
      "dot": "rose",
      "title": "Gates",
      "items": [
        "check_stack renders the merged config and dies on the first unsafe setting",
        "env -i: the caller's shell cannot override stack.env",
        "check_gotenberg runs before the shared Gotenberg starts"
      ]
    },
    {
      "dot": "amber",
      "title": "Failures after compose up",
      "items": [
        "executor, MCP and doc-tools failures are collected per stack",
        "up fails at the end; running it again repairs the state"
      ]
    }
  ]
