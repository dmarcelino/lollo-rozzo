#!/usr/bin/env bash
# lolloctl: run several Lettuce stacks on one host, one per person, each behind
# its own Cloudflare Tunnel and Cloudflare Access application (Google login).
# See README.md and docs/.
set -euo pipefail

LOLLO_HOME=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
# shellcheck source=lib/common.sh
. "$LOLLO_HOME/lib/common.sh"
# shellcheck source=lib/cloudflare.sh
. "$LOLLO_HOME/lib/cloudflare.sh"

MIN_COMPOSE=2.24.0

usage() {
  cat <<'EOF'
Usage: lolloctl <command> [args]

Setup
  init                          check the Cloudflare setup step by step, download Lettuce, look up Cloudflare ids
  apply [--dry-run|--yes]       make the stacks match stacks.conf (add, users), then up all and skills all;
                                reports stacks missing from it and never removes one
  add <name> <email>[,<email>]  create a stack: hostnames, Access policy + apps, tunnel, DNS; start it
  users <name> <email>[,...]    replace who may sign in (Access policy, ALLOWED_USERS and stacks.conf together)
  remove <name> [--purge]       stop a stack and delete its Cloudflare resources (--purge: its data too)
  profiles [<p>,<p>...]         show, or set for every stack, the compose profiles (optional features)
  upgrade <tag>                 move Lettuce to another tag and update every stack
  self-upgrade vX.Y.Z           (released lolloctl only) move lollo-rozzo to another release,
                                or to a pull request's dev build, vX.Y.Z-dev.<slug>.<N>
  version                       lollo-rozzo's release, or the clone it runs from
  dns-preflight <domain> <ns> <ns> [names...]
                                compare two nameservers before moving a domain (docs/cloudflare-setup.md, step 2.6)

Operation (<target> is a stack name or "all")
  up <target>                   check, then build what is built here, and start
  down <target>                 stop
  restart <target>              down + up (app-server and bff share a namespace; never restart one alone)
  check <target>                refuse unsafe or inconsistent configuration
  skills <target>               install agent-skills/ into running stacks (every agent of the stack)
  mcp <target> [--force]        add the document tools (office, pdf; lollo-doc-tools profile), the vault
                                (lollo-vault), News Radar (lollo-news-radar) and the browser (lollo-browser)
                                to Settings -> MCP, once per stack
                                (--force: again, also where the person removed them)
  backup <target> <dir> [opts]  copy agents, memory, workspaces, tools, vault, News Radar, notification
                                subscriptions and receipts to <dir>/<name>/
                                (--compress: a tar.gz instead; --no-tools; --with-google: Lettuce's Google
                                tokens too; --pause|--live; --keep N)
  restore <name> <backup>       put a stack back from one backup (a snapshot directory or a .tar.gz), here or
          [--yes]               on a new host; the stack must be stopped (--yes: replace its data without asking)
  status                        containers and health of every stack, and each one's runtime audit summary
  audit <target> [--verbose]    report where a stack's agent runtime departs from what lollo shipped: its
                                skills and executor, unknown skills, cron files, Settings -> MCP entries and
                                the app-server container's changes (exit 0 clean, 1 findings, 2 could not)
  audit <name> --accept <kind:key>
                                accept a reported skill:, cron:, mcp: or diff: entry as it is now
                                (--unaccept <kind:key>: report it again)
  list                          stacks, hostnames (Lettuce's and the lollo's) and allowed users
  logs <name> [service]         follow logs
  compose <name> <args...>      any other docker compose command for one stack
  shell <name> [agent]          bash in the app-server, in /work or in an agent's workspace (name or id)
  toolbox [opts] <name> <agent> bash (or cmd) in an agent's workspace with your own git config and the
          [cmd]                 credentials you choose, each opt-in: --gh, --ssh, --claude, or a 'use gh ssh claude'
                                line in ~/.config/lolloctl/toolbox (--no-credentials: none for this run);
                                --tools: the agents' installed tools, read-only (--tools=rw: writable);
                                --trust-workspace: start although the workspace holds configuration that runs code
  receipts <name> [<file.html>] verify pipelock's signed receipts and list its sessions, or write one session's
           [<session>]          report (default: the newest) to <file.html>
EOF
}

# ── helpers ──────────────────────────────────────────────────────────────────
# dns_wildcard -> success, with a warning, when the domain has a wildcard DNS
# record: public DNS then cannot tell which names are taken
dns_wildcard() {
  local domain probe
  domain=$(cfg DOMAIN)
  probe="lolloctl-probe-$(openssl rand -hex 4).$domain"
  [[ -n $(dig +short A "$probe") ]] || return 1
  warn "$domain has a wildcard DNS record, so public DNS cannot tell which names are taken; checking the Cloudflare zone only"
}

# free_hostname WILDCARD HOST... -> the first HOST that exists neither in DNS
# nor in the Cloudflare zone; fails when every one does. A non-empty WILDCARD
# (dns_wildcard) checks the Cloudflare zone only.
free_hostname() {
  local wildcard=$1 zone host rc
  shift
  zone=$(cfg CF_ZONE_ID)
  for host in "$@"; do
    if [[ -z $wildcard ]] && name_resolves "$host"; then
      info "$host already exists in DNS"
      continue
    fi
    rc=0
    cf_dns_name_taken "$zone" "$host" || rc=$?
    case $rc in
      0) info "$host already exists in the Cloudflare zone" ;;
      1)
        printf '%s' "$host"
        return 0
        ;;
      *) die "could not check $host in the Cloudflare zone" ;;
    esac
  done
  return 1
}

# pick_hostname NAME WILDCARD -> Lettuce's host: <name>.<domain>, or the
# HOSTNAME_FALLBACK name when that one is taken
pick_hostname() {
  local domain fallback first second
  domain=$(cfg DOMAIN)
  fallback=$(cfg HOSTNAME_FALLBACK)
  [[ $fallback == *%s* ]] || die "HOSTNAME_FALLBACK must contain %s"
  first=$1.$domain
  # shellcheck disable=SC2059 # the pattern is the format string by design
  second=$(printf "$fallback" "$1").$domain
  free_hostname "$2" "$first" "$second" || die "both $first and $second are taken; choose another stack name"
}

# pick_lollo_hostname LETTUCE_HOST WILDCARD -> the lollo host, named after
# Lettuce's so the two read as one stack: <label>-lollo.<domain>, where <label>
# is LETTUCE_HOST's first label, or, when that is taken, the first free of
# <label>-lollo-2 ... <label>-lollo-9
pick_lollo_hostname() {
  local base i names=()
  base=${1%%.*}-lollo
  names=("$base.$(cfg DOMAIN)")
  for i in 2 3 4 5 6 7 8 9; do
    names+=("$base-$i.$(cfg DOMAIN)")
  done
  free_hostname "$2" "${names[@]}" ||
    die "every lollo name from ${names[0]} to ${names[-1]} is taken; free one of them in DNS, or choose another stack name"
}

name_resolves() {
  local t
  for t in A AAAA CNAME TXT MX; do
    [[ -n $(dig +short "$t" "$1") ]] && return 0
  done
  return 1
}

write_new_stack_env() {
  local name=$1 host=$2 lollo=$3 emails=$4 f push
  f=$(stack_env "$name")
  push=$(push_env_lines)
  (umask 077 && mkdir -p "$(stack_dir "$name")/state")
  chmod 700 "$(stack_dir "$name")"
  (
    umask 077
    cat >"$f" <<EOF
# Lettuce stack "$name", managed by lolloctl. Read by Docker Compose.
# Secrets: keep this file mode 600 and out of version control.
LETTUCE_HOSTNAME=$host
PUBLIC_ORIGIN=https://$host
LOLLO_HOSTNAME=$lollo
LOLLO_ORIGIN=https://$lollo
ALLOWED_USERS=$emails
COMPOSE_PROFILES=$(cfg PROFILES)
LETTA_STATE_DIR=$(stack_dir "$name")/state
TZ=$(cfg TZ)
SESSION_SECRET=$(openssl rand -hex 32)
CF_ACCESS_TEAM_DOMAIN=$(cfg CF_TEAM_DOMAIN)
$push
EOF
  )
}

# google_reminder NAME -> the step only the operator can do: Google has no API
# for an OAuth client's redirect URIs.
google_reminder() {
  info "Google: add $(google_redirect_uri "$1") to your Google OAuth client's redirect URIs,"
  info "  then connect in that stack's Settings -> Google (docs/google-setup.md)"
}

# configure_tunnel NAME -> puts the stack's tunnel routes (cf_tunnel_configure)
# for its hosts and current profiles
configure_tunnel() {
  local f
  f=$(stack_env "$1")
  cf_tunnel_configure "$(cfg CF_ACCOUNT_ID)" "$(env_get "$f" CF_TUNNEL_ID)" "$(env_get "$f" LETTUCE_HOSTNAME)" \
    "$(env_get "$f" LOLLO_HOSTNAME)" "$(env_get "$f" COMPOSE_PROFILES)"
}

# ── the lollo host ──────────────────────────────────────────────────────────
# Every stack has a second hostname, <name>-lollo.<domain>, for the lollo
# pages, with its own Access application (the stack's one policy attached), so
# the lollo accepts only its own audience and never Lettuce's token, and
# nothing on Lettuce's origin can script the lollo. It exists whatever the
# profiles; with no lollo page on, the tunnel answers it with 404.

# create_lollo_app NAME -> the lollo's Access application, unless it exists
create_lollo_app() {
  local f pair
  f=$(stack_env "$1")
  [[ -z $(env_get "$f" CF_LOLLO_APP_ID) ]] || return 0
  pair=$(cf_app_create "$(cfg CF_ACCOUNT_ID)" "lollo-$1-pages" "$(env_get "$f" LOLLO_HOSTNAME)" "$(cfg CF_GOOGLE_IDP_ID)" \
    "$(cfg ACCESS_SESSION_DURATION)" "$(env_get "$f" CF_ACCESS_POLICY_ID)") || return 1
  env_set "$f" CF_LOLLO_APP_ID "${pair%% *}"
  env_set "$f" CF_LOLLO_AUD "${pair#* }"
}

# create_lollo_dns NAME -> the lollo host's DNS record, unless it exists
create_lollo_dns() {
  local f id
  f=$(stack_env "$1")
  [[ -z $(env_get "$f" CF_LOLLO_DNS_RECORD_ID) ]] || return 0
  id=$(cf_dns_cname_create "$(cfg CF_ZONE_ID)" "$(env_get "$f" LOLLO_HOSTNAME)" "$(env_get "$f" CF_TUNNEL_ID)" \
    "lolloctl stack $1 (lollo)") || return 1
  env_set "$f" CF_LOLLO_DNS_RECORD_ID "$id"
}

# route_stack NAME -> re-applies the stack's tunnel routes for its current
# profiles, and its two Access applications as cf_app_body defines them; a
# stack whose setup never finished is skipped
route_stack() {
  local f acc
  f=$(stack_env "$1")
  [[ -n $(env_get "$f" CF_TUNNEL_ID) && -n $(env_get "$f" CF_DNS_RECORD_ID) ]] || return 0
  acc=$(cfg CF_ACCOUNT_ID)
  configure_tunnel "$1" || return 1
  cf_app_update "$acc" "$(env_get "$f" CF_ACCESS_APP_ID)" "lollo-$1" "$(env_get "$f" LETTUCE_HOSTNAME)" \
    "$(cfg CF_GOOGLE_IDP_ID)" "$(cfg ACCESS_SESSION_DURATION)" "$(env_get "$f" CF_ACCESS_POLICY_ID)" || return 1
  cf_app_update "$acc" "$(env_get "$f" CF_LOLLO_APP_ID)" "lollo-$1-pages" "$(env_get "$f" LOLLO_HOSTNAME)" \
    "$(cfg CF_GOOGLE_IDP_ID)" "$(cfg ACCESS_SESSION_DURATION)" "$(env_get "$f" CF_ACCESS_POLICY_ID)"
}

# Run by sh in the app-server as: sh -c "$SKILLS_INSTALL" sh DIR SKILL... with a tar
# of the skills on stdin. Replaces what the last run installed (the manifest) and
# leaves every other skill in DIR alone. Extracting into a dot directory first
# means a broken stream changes nothing; skill discovery ignores dot directories.
# shellcheck disable=SC2016 # expanded by sh in the container
SKILLS_INSTALL='set -e
d=$1
shift
mkdir -p "$d"
t=$(mktemp -d "$d/.lolloctl.XXXXXX")
trap '\''rm -rf "$t"'\'' EXIT
tar -C "$t" --no-same-owner -xf -
if [ -f "$d/.lolloctl-skills" ]; then
  while read -r s; do [ -n "$s" ] && rm -rf "${d:?}/$s"; done <"$d/.lolloctl-skills"
fi
for s in "$@"; do
  rm -rf "${d:?}/$s"
  mv "$t/$s" "$d/$s"
done
printf "%s\n" "$@" >"$d/.lolloctl-skills"'

# sync_skills NAME -> installs agent-skills/ into the stack's global skills, which
# every agent of the stack loads; prints how many
sync_skills() {
  local src=$LOLLO_HOME/agent-skills f s skills=()
  for f in "$src"/*/SKILL.md; do
    [[ -f $f ]] || continue
    s=${f%/SKILL.md}
    s=${s##*/}
    [[ $s =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "invalid skill name '$s': lowercase letters, digits and '-'"
    # The BFF rewrites its own skills on every connect, over any of ours.
    [[ ! -e $(upstream_dir)/docker/agent-skills/$s ]] || die "skill '$s' is also shipped by upstream Lettuce; rename it"
    skills+=("$s")
  done
  if ((${#skills[@]})); then
    tar -C "$src" -cf - "${skills[@]}"
  else
    tar -cf - -T /dev/null
  fi | inert_stderr compose "$1" exec -T app-server sh -c "$SKILLS_INSTALL" sh /root/.letta/skills "${skills[@]}" ||
    die "$1: could not install skills (is the stack up?)"
  printf '%s' "${#skills[@]}"
}

# The lollo executor (landing/executor/run.mjs): the app-server's cron runs it
# every minute, through upstream's agent-env (PID 1's environment) without
# NODE_USE_ENV_PROXY: everything it calls is inside the stack, its token must
# never reach pipelock, and Node >= 22.21 would otherwise warn on every run. It sends
# `letta agents list` to the landing service when that asks for one and, with
# the lollo-gmail-triggers profile (--gmail-triggers) and the lollo-news-radar
# profile (--news-radar), fetches that sidecar's queued requests over /executor/v1/
# and turns each into `letta cron add --once`. It
# lives in a namespace we own under letta-home, so a restart keeps it; the cron
# file goes to system-cron, which the entrypoint copies to /etc/cron.d at every
# start. Its token stays in the container layer, out of the state directory and
# its backups; every recreate goes through `up`, which installs it again.
# Agents can read the token: it keeps the stack's other containers out, not
# them. Installed only when it has work (executor_wanted): the vault alone gives
# it none.
EXECUTOR_DIR=/root/.letta/lollo/executor
EXECUTOR_JOB="lollo-rozzo-executor"
EXECUTOR_TOKEN_FILE=/etc/lollo-rozzo/executor-token

# executor_wanted PROFILES -> success when the executor has work under PROFILES:
# Gmail triggers' or News Radar's requests, or the agent list, which landing asks for
# only with the code editor on (its links to the agents' workspaces)
executor_wanted() {
  has_profile "$1" lollo-gmail-triggers || has_profile "$1" lollo-news-radar || has_profile "$1" lollo-code-server
}

# executor_cron NAME -> the stack's cron file for the executor, with the flag of
# each request queue whose profile is on
executor_cron() {
  local flag="" profiles
  profiles=$(env_get "$(stack_env "$1")" COMPOSE_PROFILES)
  if has_profile "$profiles" lollo-gmail-triggers; then
    flag+=" --gmail-triggers"
  fi
  if has_profile "$profiles" lollo-news-radar; then
    flag+=" --news-radar"
  fi
  printf '%s\n' "# Installed by lolloctl (lollo-gmail-triggers, lollo-news-radar or lollo-code-server profile). Removed with the last of them." \
    "PATH=/usr/local/bin:/usr/bin:/bin" 'MAILTO=""'
  printf '%s' "* * * * * root /usr/local/bin/agent-env env -u NODE_USE_ENV_PROXY node $EXECUTOR_DIR/bin/run.mjs$flag >> $EXECUTOR_DIR/executor.log 2>&1"
}

# Run by sh in the app-server as
#   sh -c "$LOLLO_INSTALL" sh install DIR JOB CRONDIR ETCDIR TOKEN CRON  (a tar of run.mjs and token on stdin)
#   sh -c "$LOLLO_INSTALL" sh uninstall DIR JOB CRONDIR ETCDIR TOKEN
# install replaces DIR/bin/run.mjs, the token file TOKEN (0600, its directory
# 0700) and the cron text CRON in CRONDIR/JOB and ETCDIR/JOB (which starts it
# now), each by a rename from a dot file next to it. The token comes on stdin,
# never in argv. Nothing changes unless the stream holds both files.
# uninstall removes both cron files, the token (and its directory once empty)
# and DIR/bin.
# shellcheck disable=SC2016 # expanded by sh in the container
LOLLO_INSTALL='set -e
mode=$1 d=$2 job=$3 sys=$4 etc=$5 tok=$6
if [ "$mode" = uninstall ]; then
  rm -f "$etc/$job" "$sys/$job" "$tok"
  rmdir "${tok%/*}" 2>/dev/null || :
  rm -rf "${d:?}/bin"
  exit 0
fi
cron=$7
t=$(mktemp -d)
trap '\''rm -rf "$t"'\'' EXIT
tar -C "$t" --no-same-owner -xf -
for f in run.mjs token; do
  [ -f "$t/$f" ] || { echo "$f is missing from the stream" >&2; exit 1; }
done
printf "%s\n" "$cron" >"$t/cron"
put() { install -m "$2" "$1" "${3%/*}/.${3##*/}.new" && mv -f "${3%/*}/.${3##*/}.new" "$3"; }
mkdir -p "$d/bin" "$sys" "$etc" "${tok%/*}"
chmod 700 "${tok%/*}"
put "$t/run.mjs" 0644 "$d/bin/run.mjs"
put "$t/token" 0600 "$tok"
put "$t/cron" 0644 "$sys/$job"
put "$t/cron" 0644 "$etc/$job"'

# executor_present NAME DIR JOB -> success when the stack's letta-home holds
# DIR/bin or the cron file JOB (seen from the host, so stacks that never had
# that executor cost no exec)
executor_present() {
  local h
  h=$(env_get "$(stack_env "$1")" LETTA_STATE_DIR)/letta-home
  [[ -e $h/${2#/root/.letta/}/bin || -e $h/system-cron/$3 ]]
}

# executor_installed NAME -> success when the stack has the lollo executor
executor_installed() {
  executor_present "$1" "$EXECUTOR_DIR" "$EXECUTOR_JOB"
}

# remove_executor NAME DIR JOB TOKEN -> removes one executor install, its token
# and its cron files from the running app-server
remove_executor() {
  inert_stderr compose "$1" exec -T app-server sh -c "$LOLLO_INSTALL" sh uninstall "$2" "$3" \
    /root/.letta/system-cron /etc/cron.d "$4" </dev/null
}

# install_executor NAME -> streams the executor and the stack's executor token
# into the running app-server. The token file is built in a private temp dir
# and travels inside the tar.
install_executor() {
  local src=$LOLLO_HOME/landing/executor tmp rc=0
  [[ -f $src/run.mjs ]] || {
    warn "$src/run.mjs is missing"
    return 1
  }
  [[ $(env_get "$(stack_env "$1")" LOLLO_EXECUTOR_TOKEN) =~ ^[0-9a-f]{64}$ ]] || {
    warn "$1: LOLLO_EXECUTOR_TOKEN is missing or malformed; not installing the executor"
    return 1
  }
  tmp=$(mktemp -d) || return 1
  cp "$src/run.mjs" "$tmp/run.mjs" &&
    (umask 077 && printf '%s\n' "$(env_get "$(stack_env "$1")" LOLLO_EXECUTOR_TOKEN)" >"$tmp/token") || rc=1
  if ((rc == 0)); then
    tar -C "$tmp" -cf - run.mjs token |
      inert_stderr compose "$1" exec -T app-server sh -c "$LOLLO_INSTALL" sh install "$EXECUTOR_DIR" "$EXECUTOR_JOB" \
        /root/.letta/system-cron /etc/cron.d "$EXECUTOR_TOKEN_FILE" "$(executor_cron "$1")" || rc=1
  fi
  rm -rf "$tmp"
  return "$rc"
}

# uninstall_executor NAME -> removes the executor, its token and its cron file
uninstall_executor() {
  remove_executor "$1" "$EXECUTOR_DIR" "$EXECUTOR_JOB" "$EXECUTOR_TOKEN_FILE" || return 1
  info "$1: removed the lollo executor (none of lollo-gmail-triggers, lollo-news-radar and lollo-code-server is on)"
}

# sync_executor NAME -> the running stack has the executor exactly when it has
# work there (executor_wanted); warns and fails when it cannot make it so
sync_executor() {
  if executor_wanted "$(env_get "$(stack_env "$1")" COMPOSE_PROFILES)"; then
    install_executor "$1" && return 0
    warn "$1: could not install the lollo executor; the stack is up, but its landing page gets no agent list and its Gmail triggers will not run"
    return 1
  elif executor_installed "$1"; then
    uninstall_executor "$1" && return 0
    warn "$1: could not remove the lollo executor, so it may still run"
    return 1
  fi
}

# executor_out_of_step NAME... -> fails, naming the stacks whose executor could
# not be synced; `up` syncs it again, whatever command stopped
executor_out_of_step() {
  die "the lollo executor is out of step on: $*; fix the cause, then run: lolloctl up <name>"
}

# up_stack NAME -> checks one stack, then builds and starts it
up_stack() {
  local routed=1
  # Before anything is recreated or reinstalled: a recreate throws away the
  # container's changes, and the executor's install replaces its files.
  audit_summary "$1"
  sync_push_contact "$1"
  ensure_executor_token "$1"
  # No keypair yet: a stack from before the notifications service, whose tunnel
  # has no /notifications/ route. `up` makes no Cloudflare call; `profiles`
  # applies the routes (`add` and `profiles` make the keypair first themselves).
  notify_keypair_missing "$1" && routed=0
  # Or a stack from before a sender was added to NOTIFY_SOURCES, whose only
  # senders on are new ones: its tunnel had no reason to route /notifications/.
  notify_route_unrouted "$1" && routed=0
  ensure_notify_secrets "$1"
  ((routed)) || notify_route_reminder "$1"
  ensure_browser_secrets "$1"
  sync_lollo_profiles "$1"
  sync_news_radar_settings "$1"
  check_stack "$1"
  # The app-server mounts the tools' volume and joins the network; both must exist.
  if has_profile "$(env_get "$(stack_env "$1")" COMPOSE_PROFILES)" lollo-doc-tools; then
    ensure_doc_tools_volume || die "could not fill the volume $(doc_tools_volume) (docs/doc-tools.md)"
    ensure_doc_tools_network "$1" || die "$1: could not create the network $(doc_tools_network "$1")"
  fi
  info "starting $1"
  build_local_images "$1"
  if has_profile "$(env_get "$(stack_env "$1")" COMPOSE_PROFILES)" lollo-browser; then
    start_browser_engine "$1"
  fi
  # Never a build here: an image that should be published but is missing fails
  # instead of building from a context the released image does not carry. An
  # image already on the host is not pulled again.
  compose "$1" up -d --no-build --pull missing --remove-orphans
}

# notify_route_reminder NAME -> with a sender on, says to run `profiles` once
# (with the current list, which changes and restarts nothing), so the tunnel
# routes the stack's /notifications/
notify_route_reminder() {
  local f
  f=$(stack_env "$1")
  [[ -n $(notify_profiles "$(env_get "$f" COMPOSE_PROFILES)") ]] || return 0
  warn "$1: the tunnel does not route https://$(env_get "$f" LOLLO_HOSTNAME)/notifications/ yet, and up makes no Cloudflare call; run once: lolloctl profiles $(cfg PROFILES) (the current list: it routes every stack and restarts none)"
}

# The line the browser's engine logs, before it exits 3, when Chromium's
# sandbox cannot start (browser/engine/).
BROWSER_SANDBOX_FAILED="lollo-browser-engine: Chromium's sandbox failed"

# start_browser_engine NAME -> starts the browser's engine alone, before the
# rest of the stack, and waits until it is healthy. When Chromium's sandbox
# cannot start on this host, it stops the engine and dies, naming the host
# settings: the browser never runs without the sandbox, and nothing here
# retries it any other way.
start_browser_engine() {
  local logs
  compose "$1" up -d --no-build --pull missing --wait --wait-timeout 180 lollo-browser-engine && return 0
  logs=$(compose "$1" logs --no-color --tail 200 lollo-browser-engine 2>&1) || logs=""
  # Its restart policy would start it again and again.
  compose "$1" stop lollo-browser-engine >/dev/null 2>&1 || warn "$1: could not stop lollo-browser-engine"
  if grep -qF -- "$BROWSER_SANDBOX_FAILED" <<<"$logs"; then
    die "$1: Chromium's sandbox cannot start on this host, so the browser does not run (it never runs without its sandbox). Allow unprivileged user namespaces (sysctl user.max_user_namespaces above 0, and on Debian kernels kernel.unprivileged_userns_clone=1) and keep Docker's default AppArmor profile, then run: lolloctl up $1 (docs/browser.md, \"Running it\"); or turn the lollo-browser profile off"
  fi
  die "$1: the browser's engine did not become healthy; see: lolloctl compose $1 logs lollo-browser-engine (docs/browser.md, \"Running it\")"
}

# build_local_images NAME -> builds the stack's images that are built on this
# host: upstream's when it publishes none for it (LETTA_IMAGE_NS empty), then
# the lollo's: from a clone all of them, in release mode only those RELEASE
# does not name (the code editor's shell, FROM the app-server's image). Two
# calls, in that order, since the shell names the app-server's image.
build_local_images() {
  local rendered published upstream=() lollo=()
  # up_stack runs check_stack just before: its render is this stack's config.
  if [[ $CHECKED_NAME == "$1" ]]; then
    rendered=$CHECKED_CONFIG
  else
    rendered=$(compose "$1" config --format json) || die "$1: docker compose config failed"
  fi
  if [[ -z $(cfg LETTA_IMAGE_NS) ]]; then
    mapfile -t upstream < <(jq -r '.services | to_entries[] | select(.value.build != null)
      | select(.key == "landing" or (.key | startswith("lollo-")) | not) | .key' <<<"$rendered")
  fi
  published=""
  if release_mode; then published=$(published_images | awk '$4 != "-" { print $4 }' | paste -sd, -); fi
  mapfile -t lollo < <(jq -r --arg p ",$published," '.services | to_entries[] | select(.value.build != null)
    | .key as $k | select($k == "landing" or ($k | startswith("lollo-"))) | select($p | contains("," + $k + ",") | not) | $k' <<<"$rendered")
  if ((${#upstream[@]})); then
    compose "$1" build "${upstream[@]}" || die "$1: could not build ${upstream[*]}"
  fi
  if ((${#lollo[@]})); then
    compose "$1" build "${lollo[@]}" || die "$1: could not build ${lollo[*]}"
  fi
}

# ── document tools ───────────────────────────────────────────────────────────
# The image is shared by every stack and built here, not by Compose: it is
# never run, only copied into the volume the app-servers mount. The volume and
# the networks are lolloctl's too, so Compose never removes them (see
# compose/doc-tools.yml).

# DOC_TOOLS_VOLUME_LABEL marks the volumes lolloctl made, with their tag.
DOC_TOOLS_VOLUME_LABEL=lollo.doc-tools.tag
# Written last into a filled volume: one without it is filled again.
DOC_TOOLS_MARKER=.lollo-doc-tools-complete
# Run by sh in the backup image's container: unpacks the tools streamed on
# stdin into the volume, then writes the marker.
DOC_TOOLS_FILL="tar -x -C /dst && touch /dst/$DOC_TOOLS_MARKER"

# ensure_doc_tools_image -> builds lollo-doc-tools:<content hash> unless it exists
ensure_doc_tools_image() {
  local image
  image=$(doc_tools_image)
  host_docker image inspect "$image" >/dev/null 2>&1 && return 0
  info "building $image (the document tools; the first build downloads them and takes a few minutes)"
  host_docker build -q -t "$image" "$LOLLO_HOME/doc-tools" >/dev/null
}

# ensure_doc_tools_volume -> the tools' volume of this tree exists and is
# complete, under a host-wide lock: the volume is shared, and a second
# lolloctl would remove it under the first one's fill (whose `run -v` would
# then create it unlabelled)
ensure_doc_tools_volume() {
  local lock rc=0
  mkdir -p "$LOLLO_DATA/stacks"
  exec {lock}>"$LOLLO_DATA/stacks/.doc-tools.lock"
  if ! flock -n "$lock"; then
    info "waiting for another lolloctl to finish with the volume $(doc_tools_volume)"
    flock "$lock"
  fi
  fill_doc_tools_volume || rc=1
  exec {lock}>&-
  return "$rc"
}

# fill_doc_tools_volume -> fills the tools' volume unless it is complete. It is
# filled from a container of the image (built only then) that is created, never
# started, and copied out into the backup image's container (no network, no
# capabilities but file ownership), which writes the marker last. A volume
# without the marker (an interrupted fill) is filled again; one lolloctl did
# not make (no label for this tag, another driver, or driver options such as a
# bind to a host directory) is refused, since every app-server would run what
# it holds.
fill_doc_tools_volume() {
  local vol cid c rc=0
  vol=$(doc_tools_volume)
  ensure_backup_image || return 1
  if host_docker volume inspect "$vol" >/dev/null 2>&1; then
    [[ $(host_docker volume inspect --format "{{.Driver}} {{index .Labels \"$DOC_TOOLS_VOLUME_LABEL\"}}|{{len .Options}}" "$vol") == "local $(doc_tools_tag)|0" ]] || {
      warn "$vol was not made by lolloctl; remove it (docker volume rm $vol), then run the same command again"
      return 1
    }
    host_docker "${BACKUP_RUN[@]}" -v "$vol:/dst:ro" "$BACKUP_IMAGE" test -f "/dst/$DOC_TOOLS_MARKER" >/dev/null 2>&1 && return 0
    host_docker volume rm "$vol" >/dev/null 2>&1 || {
      warn "$vol is incomplete and in use; stop every stack with doc-tools (lolloctl down all), then run: lolloctl up all"
      return 1
    }
  fi
  ensure_doc_tools_image || {
    warn "could not build $(doc_tools_image) (doc-tools/Dockerfile)"
    return 1
  }
  # Containers an interrupted fill left; they would keep old images in use.
  for c in $(host_docker ps -aq --filter label=lolloctl.doc-tools=fill); do
    host_docker rm -f "$c" >/dev/null 2>&1 || true
  done
  info "copying the document tools into the volume $vol"
  host_docker volume create --label "$DOC_TOOLS_VOLUME_LABEL=$(doc_tools_tag)" "$vol" >/dev/null || return 1
  cid=$(host_docker create --label lolloctl.doc-tools=fill "$(doc_tools_image)" /none) || return 1
  host_docker cp "$cid:$DOC_TOOLS_TARGET/." - |
    host_docker "${BACKUP_RUN[@]}" -i --label lolloctl.doc-tools=fill -v "$vol:/dst" "$BACKUP_IMAGE" sh -c "$DOC_TOOLS_FILL" || rc=1
  host_docker rm -f "$cid" >/dev/null 2>&1 || true
  return "$rc"
}

# ensure_doc_tools_network NAME -> the stack's internal network to Gotenberg exists
ensure_doc_tools_network() {
  local net
  net=$(doc_tools_network "$1")
  host_docker network inspect "$net" >/dev/null 2>&1 && return 0
  host_docker network create --internal --label "$DOC_TOOLS_LABEL=$1" "$net" >/dev/null
}

# gotenberg_id -> the shared Gotenberg's container id; nothing when it doesn't exist
gotenberg_id() { compose_shared ps -aq gotenberg; }

# drop_doc_tools_network NET [GOTENBERG_ID] -> detaches Gotenberg from NET and
# deletes it; fails when a stack's container still uses it
drop_doc_tools_network() {
  if [[ -n ${2:-} ]]; then
    host_docker network disconnect -f "$1" "$2" >/dev/null 2>&1 || true
  fi
  host_docker network rm "$1" >/dev/null
}

# sync_doc_tools -> makes the shared Gotenberg, the networks and the tools'
# volumes match the profiles: with doc-tools on, Gotenberg runs and is attached
# to the network of every complete stack that has the profile, when that
# network is internal and labelled for that stack (ensure_doc_tools_network
# keeps any network of that name, so one made by hand is refused here, as
# check_doc_tools refuses it at the stack's own `up`); networks of stacks that
# are gone or removed are deleted, and so are volumes of older tags; with it
# off, Gotenberg, every network and every volume go. A volume still in use stays
# for a later run: it is only disk space. It compares what exists rather than
# what changed, so a re-run repairs an interrupted one. Warns and fails when it
# cannot.
sync_doc_tools() {
  local n net id rendered rc=0 attached listed vol current=""
  local -a have=() want=() names=()
  listed=$(host_docker network ls --filter "label=$DOC_TOOLS_LABEL" --format '{{.Name}}') || return 1
  mapfile -t have <<<"$listed"
  if has_profile "$(cfg PROFILES)" lollo-doc-tools; then
    for n in $(list_stacks); do
      has_profile "$(env_get "$(stack_env "$n")" COMPOSE_PROFILES)" lollo-doc-tools || continue
      [[ -n $(env_get "$(stack_env "$n")" CF_DNS_RECORD_ID) ]] || continue
      want+=("$(doc_tools_network "$n")")
      names+=("$n")
      ensure_doc_tools_network "$n" || {
        warn "$n: could not create the network $(doc_tools_network "$n")"
        rc=1
      }
    done
    rendered=$(compose_shared config --format json) || return 1
    check_gotenberg "$rendered"
    compose_shared up -d --remove-orphans || return 1
    id=$(gotenberg_id) || return 1
    [[ -n $id ]] || return 1
    for n in "${!want[@]}"; do
      net=${want[n]}
      # shellcheck disable=SC2016 # a Go template, not shell
      attached=$(host_docker network inspect "$net" --format '{{range $k, $v := .Containers}}{{$k}} {{end}}' 2>/dev/null) || {
        rc=1
        continue
      }
      if [[ $(host_docker network inspect "$net" --format "{{.Internal}} {{index .Labels \"$DOC_TOOLS_LABEL\"}}") != "true ${names[n]}" ]]; then
        warn "${names[n]}: $net must be an internal network lolloctl made for ${names[n]}; Gotenberg stays off it. Remove it (docker network rm $net) and run: lolloctl up ${names[n]}"
        [[ " $attached " != *" $id "* ]] || host_docker network disconnect -f "$net" "$id" >/dev/null 2>&1 || true
        rc=1
        continue
      fi
      [[ " $attached " == *" $id "* ]] && continue
      host_docker network connect --alias gotenberg "$net" "$id" || {
        warn "could not connect Gotenberg to $net"
        rc=1
      }
    done
  else
    id=$(gotenberg_id) || return 1
    if [[ -n $id ]]; then
      info "stopping the shared Gotenberg (the lollo-doc-tools profile is off)"
      compose_shared down || return 1
      id=""
    fi
  fi
  for net in "${have[@]}"; do
    [[ -n $net ]] || continue
    ((${#want[@]})) && printf '%s\n' "${want[@]}" | grep -qxF -- "$net" && continue
    drop_doc_tools_network "$net" "$id" || {
      warn "could not remove the network $net; a container may still use it"
      rc=1
    }
  done
  has_profile "$(cfg PROFILES)" lollo-doc-tools && current=$(doc_tools_volume)
  for vol in $(host_docker volume ls --filter "label=$DOC_TOOLS_VOLUME_LABEL" --format '{{.Name}}' 2>/dev/null); do
    [[ $vol == "$current" ]] || host_docker volume rm "$vol" >/dev/null 2>&1 || true
  done
  return "$rc"
}

# ── lolloctl's servers in Settings -> MCP ──────────────────────────────────
# Lettuce's shared MCP list belongs to its BFF. lib/mcp-servers.mjs adds or
# removes only one group's own entries (the document tools: those that run one;
# the vault, News Radar and the browser: their exact HTTP entry), and refuses a file of any other shape; see
# it for why that is safe next to the BFF's own writes. Registering is once per
# stack and group (the group's marker in stack.env), so a server the person
# removed stays removed; with the group's profile off, its servers are taken
# out again, since a server that cannot start or answer makes every
# `letta mcp tools` call fail, the other servers' included.
MCP_SETTINGS=/root/.letta/mcp-home/.letta/settings.json
MCP_GROUPS=(doc-tools vault news-radar browser)
declare -A MCP_PROFILE=([doc-tools]=lollo-doc-tools [vault]=lollo-vault [news-radar]=lollo-news-radar [browser]=lollo-browser)
declare -A MCP_MARKER=([doc-tools]=DOC_TOOLS_MCP_REGISTERED [vault]=VAULT_MCP_REGISTERED [news-radar]=NEWS_RADAR_MCP_REGISTERED
  [browser]=BROWSER_MCP_REGISTERED)
declare -A MCP_LABEL=([doc-tools]="the document tools" [vault]="the vault" [news-radar]="News Radar" [browser]="the browser")
# What a same-named server of the person's differs in.
declare -A MCP_KIND=([doc-tools]=command [vault]=URL [news-radar]=URL [browser]=URL)
# Set by register_mcp_group and drop_mcp_group when they changed the list.
MCP_CHANGED=0

# mcp_groups PROFILES -> the groups whose profile is in PROFILES, one per line
mcp_groups() {
  local g
  for g in "${MCP_GROUPS[@]}"; do
    ! has_profile "$1" "${MCP_PROFILE[$g]}" || echo "$g"
  done
}

# mcp_reminder NAME PROFILES -> whether the stack's Settings -> MCP has the
# servers of each group whose profile is on, as far as lolloctl knows (it
# registers them once: `mcp`, `add`), or the entries to add by hand
mcp_reminder() {
  local f url g missing=""
  f=$(stack_env "$1")
  url=https://$(env_get "$f" LETTUCE_HOSTNAME)
  for g in $(mcp_groups "$2"); do
    if [[ -n $(env_get "$f" "${MCP_MARKER[$g]}") ]]; then
      case $g in
        doc-tools) info "Documents: office and pdf are in $url Settings -> MCP (docs/doc-tools.md)" ;;
        vault) info "Vault: vault is in $url Settings -> MCP (docs/vault.md)" ;;
        news-radar) info "News Radar: news-radar is in $url Settings -> MCP (docs/news-radar.md)" ;;
        browser) info "Browser: browser is in $url Settings -> MCP (docs/browser.md)" ;;
      esac
      continue
    fi
    missing=1
    case $g in
      doc-tools)
        info "Documents: in $url Settings -> MCP, add two stdio servers:"
        info "  office -> /opt/lollo-doc-tools/bin/officeagent   pdf -> /opt/lollo-doc-tools/bin/pdf-mcp (docs/doc-tools.md)"
        ;;
      vault)
        info "Vault: in $url Settings -> MCP, add an HTTP server:"
        info "  vault -> http://lollo-vault:8000/mcp (docs/vault.md)"
        ;;
      news-radar)
        info "News Radar: in $url Settings -> MCP, add an HTTP server:"
        info "  news-radar -> http://lollo-news-radar:8000/mcp (docs/news-radar.md)"
        ;;
      browser)
        info "Browser: in $url Settings -> MCP, add an HTTP server:"
        info "  browser -> http://lollo-browser:8000/mcp (docs/browser.md)"
        ;;
    esac
  done
  [[ -z $missing ]] || info "  or run: lolloctl mcp $1"
}

# mcp_servers NAME add|remove GROUP -> runs lib/mcp-servers.mjs in the stack's
# app-server (streamed on stdin, nothing copied in); prints its JSON summary
mcp_servers() {
  inert_stderr compose "$1" exec -T app-server node --input-type=module - "$2" "$MCP_SETTINGS" "$3" <"$LOLLO_HOME/lib/mcp-servers.mjs"
}

# refresh_mcp_skill NAME -> after a change to the list, restarts the stack's BFF
# alone: agents learn the servers from the mcp-servers skill's description,
# which the BFF renders from the list when it connects to the app-server
# (ensureMcpServers), not when the file changes. The app-server, whose network
# namespace the BFF shares, keeps running, and its stop_grace_period lets an
# in-flight turn finish first. A failure only delays what agents see.
refresh_mcp_skill() {
  info "$1: restarting its BFF so agents see the change (a turn in progress finishes first)"
  compose "$1" restart --no-deps bff >/dev/null ||
    warn "$1: could not restart its BFF; agents see the change after: lolloctl restart $1"
}

# register_mcp_group NAME GROUP -> adds GROUP's servers to the stack's
# Settings -> MCP and marks the stack; fails, unmarked, when it could not
register_mcp_group() {
  local out added present c n i
  out=$(mcp_servers "$1" add "$2") || {
    warn "$1: could not add ${MCP_LABEL[$2]} to Settings -> MCP"
    return 1
  }
  env_set "$(stack_env "$1")" "${MCP_MARKER[$2]}" 1
  # Server names come from the app-server's settings file, which agents can write.
  added=$(printable "$(jq -r '.added // [] | map(tostring) | join(", ")' <<<"$out" 2>/dev/null)")
  present=$(printable "$(jq -r '.present // [] | map(tostring) | join(", ")' <<<"$out" 2>/dev/null)")
  if [[ -n $added ]]; then
    info "$1: added $added to Settings -> MCP${present:+ (already there: $present)}"
    MCP_CHANGED=1
  elif [[ -n $present ]]; then
    info "$1: $present already in Settings -> MCP"
  fi
  # One at a time, so a name holding a newline stays one name.
  n=$(jq -r '.conflicts // [] | length' <<<"$out" 2>/dev/null) || n=0
  for ((i = 0; i < n; i++)); do
    c=$(jq -r --argjson i "$i" '.conflicts[$i] | tostring' <<<"$out")
    info "$1: Settings -> MCP already has a $(printable "$c") server with another ${MCP_KIND[$2]}; it was left as it is"
  done
}

# register_mcp NAME FORCE GROUP... -> registers each GROUP in the stack's
# Settings -> MCP, skipping a group registered before unless FORCE is
# --force, and restarts its BFF once when that changed the list; fails when a
# group could not be added
register_mcp() {
  local name=$1 force=$2 f g rc=0
  shift 2
  f=$(stack_env "$name")
  MCP_CHANGED=0
  for g in "$@"; do
    if [[ -n $(env_get "$f" "${MCP_MARKER[$g]}") && $force != --force ]]; then
      info "$name: registered ${MCP_LABEL[$g]} before; a server the person removed stays removed (--force adds it again)"
      continue
    fi
    register_mcp_group "$name" "$g" || rc=1
  done
  ((MCP_CHANGED == 0)) || refresh_mcp_skill "$name"
  return "$rc"
}

# drop_mcp_group NAME GROUP -> with GROUP's profile off, removes the servers
# registered in the stack's Settings -> MCP; fails, still marked, when it could not
drop_mcp_group() {
  local f out removed
  f=$(stack_env "$1")
  [[ -n $(env_get "$f" "${MCP_MARKER[$2]}") ]] || return 0
  ! has_profile "$(env_get "$f" COMPOSE_PROFILES)" "${MCP_PROFILE[$2]}" || return 0
  out=$(mcp_servers "$1" remove "$2") || {
    warn "$1: could not remove ${MCP_LABEL[$2]} from Settings -> MCP"
    return 1
  }
  env_unset "$f" "${MCP_MARKER[$2]}"
  removed=$(printable "$(jq -r '.removed // [] | map(tostring) | join(", ")' <<<"$out" 2>/dev/null)")
  [[ -n $removed ]] || return 0
  info "$1: removed $removed from Settings -> MCP (the ${MCP_PROFILE[$2]} profile is off)"
  MCP_CHANGED=1
}

# drop_mcp_servers NAME -> drops every group whose profile is off
# (drop_mcp_group), and restarts the stack's BFF once when that changed the list
drop_mcp_servers() {
  local g rc=0
  MCP_CHANGED=0
  for g in "${MCP_GROUPS[@]}"; do
    drop_mcp_group "$1" "$g" || rc=1
  done
  ((MCP_CHANGED == 0)) || refresh_mcp_skill "$1"
  return "$rc"
}

# ── commands ─────────────────────────────────────────────────────────────────
cmd_init() {
  local c v f ref
  for c in docker curl jq openssl dig tar; do
    command -v "$c" >/dev/null || die "$c is required but not installed"
  done
  v=$(docker compose version --short 2>/dev/null) || die "the Docker Compose plugin is required"
  version_ge "${v#v}" "$MIN_COMPOSE" || die "Docker Compose >= 2.24 is required (found $v)"

  f=$(config_file)
  if [[ ! -f $f ]]; then
    (umask 077 && mkdir -p "$LOLLO_DATA" && cp "$LOLLO_HOME/config.env.example" "$f")
    chmod 600 "$f"
    # A release starts on the Lettuce it was tested with.
    if release_mode; then env_set "$f" LETTUCE_REF "$(release_get LETTUCE_REF)"; fi
    die "created $f; edit DOMAIN, PUSH_CONTACT_EMAIL, PROFILES and TZ, then run: lolloctl init"
  fi
  [[ -f $(stacks_conf) ]] || conf_create
  require_config
  init_cloudflare

  ref=$(cfg LETTUCE_REF)
  fetch_upstream "$ref"
  sync_upstream_images
  info "ready: zone $(cfg DOMAIN), Access team $(cfg CF_TEAM_DOMAIN).cloudflareaccess.com, Lettuce $ref"
  info "next: list who gets a stack in $(stacks_conf), then run: lolloctl apply"
}

# init_cloudflare -> walks docs/cloudflare-setup.md: checks each step the
# token can see, in order, stops at the first one missing with its step number,
# and caches the ids lolloctl needs in config.env
init_cloudflare() {
  local f zone acc team idp status missing=()
  f=$(token_file)
  [[ -f $f ]] || die "no Cloudflare API token at $f (docs/cloudflare-setup.md, step 5)"
  [[ $(file_mode "$f") == 600 ]] || die "the API token file must be mode 600 (chmod 600 $f)"

  zone=$(cf_api GET "/zones?name=$(cfg DOMAIN)") || die "could not look up the zone: is the API token valid? (docs/cloudflare-setup.md, step 5)"
  [[ $(jq 'length' <<<"$zone") != 0 ]] ||
    die "zone $(cfg DOMAIN) not found: add the domain to Cloudflare (docs/cloudflare-setup.md, step 2.3), and give the token Zone Read on it (step 5)"
  status=$(jq -r '.[0].status' <<<"$zone")
  acc=$(jq -r '.[0].account.id' <<<"$zone")
  zone=$(jq -r '.[0].id' <<<"$zone")
  if [[ $status != active ]]; then
    warn "zone $(cfg DOMAIN) is $status, not active: switch the nameservers at the registrar and wait (docs/cloudflare-setup.md, steps 2.7 and 2.8)"
    if [[ $(cf_api GET "/zones/$zone/dnssec" 2>/dev/null | jq -r '.status // empty') == active ]]; then
      warn "DNSSEC is on for $(cfg DOMAIN); turn it off at the registrar first (docs/cloudflare-setup.md, step 2.2)"
    fi
  fi

  team=$(cf_team "$acc") ||
    die "could not read the Zero Trust organization: the token needs Access: Organizations, Identity Providers, and Groups Read (docs/cloudflare-setup.md, step 5)"
  [[ -n $team ]] || die "no Zero Trust organization yet (docs/cloudflare-setup.md, step 3)"
  idp=$(cf_google_idp "$acc") || die "could not list Access login methods (docs/cloudflare-setup.md, step 5)"
  [[ -n $idp ]] || die "no Google login method in Zero Trust (docs/cloudflare-setup.md, step 4)"

  # The rest of the token's scopes, each by a read of what it covers. A write
  # scope cannot be checked without writing; its read is the best sign.
  cf_api GET "/accounts/$acc/cfd_tunnel?per_page=1" >/dev/null 2>&1 || missing+=("Account, Cloudflare Tunnel, Edit")
  cf_api GET "/accounts/$acc/access/apps?per_page=1" >/dev/null 2>&1 || missing+=("Account, Access: Apps and Policies, Edit")
  cf_api GET "/zones/$zone/dns_records?per_page=1" >/dev/null 2>&1 || missing+=("Zone, DNS, Edit")
  ((${#missing[@]} == 0)) || die "the API token lacks: $(printf '%s; ' "${missing[@]}" | sed 's/; $//') (docs/cloudflare-setup.md, step 5)"

  f=$(config_file)
  env_set "$f" CF_ZONE_ID "$zone"
  env_set "$f" CF_ACCOUNT_ID "$acc"
  env_set "$f" CF_TEAM_DOMAIN "$team"
  env_set "$f" CF_GOOGLE_IDP_ID "$idp"
}

cmd_add() {
  (($# == 2)) || die "usage: lolloctl add <name> <email>[,<email>]"
  local name=$1 emails f host lollo wildcard="" acc id pair synced=1 docs=1 g groups=()
  validate_name "$name"
  emails=$(normalise_emails "$2")
  require_initialised
  # The new stack.env and the stack's up need it; checked before any Cloudflare call.
  push_contact >/dev/null
  f=$(stack_env "$name")
  acc=$(cfg CF_ACCOUNT_ID)

  if [[ -n $(env_get "$f" CF_DNS_RECORD_ID) ]]; then
    die "stack '$name' already exists (use: lolloctl users|up|remove $name)"
  elif [[ -f $f ]]; then
    host=$(env_get "$f" LETTUCE_HOSTNAME)
    info "resuming the unfinished setup of '$name' ($host)"
    # The addresses given now win (stacks.conf's, from apply). With the policy
    # made already, it changes with ALLOWED_USERS, as `users` does.
    if [[ $(env_get "$f" ALLOWED_USERS) != "$emails" ]]; then
      if [[ -n $(env_get "$f" CF_ACCESS_POLICY_ID) ]]; then
        cf_policy_update "$acc" "$(env_get "$f" CF_ACCESS_POLICY_ID)" "lollo-$name" "$emails" ||
          die "could not update the Access policy of '$name'"
      fi
      env_set "$f" ALLOWED_USERS "$emails"
    fi
  else
    # <name>-lollo.<domain> is the lollo host of the stack <name>.
    [[ $name != *-lollo ]] || die "invalid stack name '$name': it may not end in -lollo, which names each stack's lollo host"
    dns_wildcard && wildcard=1
    host=$(pick_hostname "$name" "$wildcard")
    lollo=$(pick_lollo_hostname "$host" "$wildcard")
    write_new_stack_env "$name" "$host" "$lollo" "$emails"
  fi
  emails=$(env_get "$f" ALLOWED_USERS)
  # Recorded from the start, so `apply` resumes an add that stops part-way.
  conf_set "$name" "$emails" || die "could not write $(stacks_conf)"
  local hint="Cloudflare setup of '$name' stopped part-way; what exists is recorded in stacks/$name/stack.env. Fix the cause, then re-run: lolloctl add $name $emails"
  lollo=$(env_get "$f" LOLLO_HOSTNAME)
  # Before the tunnel's routes, which include /notifications/, so the up below
  # finds the keypair and has no route to remind of (notify_route_reminder).
  ensure_notify_secrets "$name"

  if [[ -z $(env_get "$f" CF_ACCESS_POLICY_ID) ]]; then
    id=$(cf_policy_create "$acc" "lollo-$name" "$emails") || die "$hint"
    env_set "$f" CF_ACCESS_POLICY_ID "$id"
  fi
  if [[ -z $(env_get "$f" CF_ACCESS_APP_ID) ]]; then
    pair=$(cf_app_create "$acc" "lollo-$name" "$host" "$(cfg CF_GOOGLE_IDP_ID)" \
      "$(cfg ACCESS_SESSION_DURATION)" "$(env_get "$f" CF_ACCESS_POLICY_ID)") || die "$hint"
    env_set "$f" CF_ACCESS_APP_ID "${pair%% *}"
    env_set "$f" CF_ACCESS_AUD "${pair#* }"
  fi
  create_lollo_app "$name" || die "$hint"
  if [[ -z $(env_get "$f" CF_TUNNEL_ID) ]]; then
    id=$(cf_tunnel_create "$acc" "lollo-$name") || die "$hint"
    env_set "$f" CF_TUNNEL_ID "$id"
  fi
  if [[ -z $(env_get "$f" CLOUDFLARE_TUNNEL_TOKEN) ]]; then
    id=$(cf_tunnel_token "$acc" "$(env_get "$f" CF_TUNNEL_ID)") || die "$hint"
    env_set "$f" CLOUDFLARE_TUNNEL_TOKEN "$id"
  fi
  configure_tunnel "$name" || die "$hint"
  create_lollo_dns "$name" || die "$hint"
  # Last: a stack with CF_DNS_RECORD_ID is complete.
  id=$(cf_dns_cname_create "$(cfg CF_ZONE_ID)" "$host" "$(env_get "$f" CF_TUNNEL_ID)" "lolloctl stack $name") || die "$hint"
  env_set "$f" CF_DNS_RECORD_ID "$id"

  # Not cmd_up: the stack is complete now, so `add` can't be re-run, and a
  # failed executor install must not hide the Google step.
  up_stack "$name"
  sync_executor "$name" || synced=0
  sync_doc_tools || docs=0
  # A new stack: nobody has chosen its MCP servers yet. The document tools
  # need Gotenberg and their network first.
  for g in $(mcp_groups "$(cfg PROFILES)"); do
    if [[ $g == doc-tools ]] && ! ((docs)); then continue; fi
    groups+=("$g")
  done
  if ((${#groups[@]})); then
    register_mcp "$name" "" "${groups[@]}" ||
      warn "$name: Settings -> MCP lacks some of lolloctl's servers; run: lolloctl mcp $name"
  fi
  info ""
  info "'$name' is up: https://$host (sign in with Google as $emails)"
  if [[ -n $(lollo_profiles "$(cfg PROFILES)") ]]; then
    info "Its lollo pages: https://$lollo/"
  fi
  info "First boot builds images and can take a few minutes; the hostname may need a minute to resolve."
  if has_profile "$(cfg PROFILES)" google; then
    google_reminder "$name"
  fi
  mcp_reminder "$name" "$(cfg PROFILES)"
  ((synced)) || executor_out_of_step "$name"
  ((docs)) || die "the document tools (shared Gotenberg, networks) are out of step; fix the cause, then run: lolloctl up $name"
}

cmd_users() {
  (($# == 2)) || die "usage: lolloctl users <name> <email>[,<email>]"
  local emails
  validate_name "$1"
  emails=$(normalise_emails "$2")
  users_update "$1" "$emails"
  cmd_up "$1"
  info "'$1' now admits: $emails"
}

# users_update NAME EMAILS -> who may sign in to NAME (normalised EMAILS): the
# Access policy, ALLOWED_USERS and stacks.conf, in that order; the stack still
# needs an `up` for ALLOWED_USERS (cmd_users does it, apply once for all)
users_update() {
  local name=$1 emails=$2 f pol
  require_initialised
  require_stack "$name"
  f=$(stack_env "$name")
  pol=$(env_get "$f" CF_ACCESS_POLICY_ID)
  [[ -n $pol ]] || die "'$name' has no Access policy yet; finish it with: lolloctl add $name $emails"
  cf_policy_update "$(cfg CF_ACCOUNT_ID)" "$pol" "lollo-$name" "$emails" || die "could not update the Access policy"
  env_set "$f" ALLOWED_USERS "$emails"
  conf_set "$name" "$emails" || die "the Access policy and stack.env now admit $emails, but $(stacks_conf) could not be written; fix it before the next apply"
}

# email_diff OLD NEW -> "<gained> <lost>" between two address lists, each
# comma-separated, "-" when empty
email_diff() {
  local gained lost
  gained=$(comm -13 <(tr , '\n' <<<"$1" | sort -u) <(tr , '\n' <<<"$2" | sort -u) | paste -sd, -)
  lost=$(comm -23 <(tr , '\n' <<<"$1" | sort -u) <(tr , '\n' <<<"$2" | sort -u) | paste -sd, -)
  printf '%s %s' "${gained:--}" "${lost:--}"
}

# apply_report ENTRIES -> what apply never changes: stacks missing from ENTRIES
# (conf_entries' "<name> <emails>" lines) and stacks whose profile list is out
# of step, each with the command to run
apply_report() {
  local entries=$1 n
  for n in $(list_stacks); do
    if ! grep -q "^$n " <<<"$entries"; then
      warn "'$n' is not in stacks.conf; apply never removes a stack. To delete it: lolloctl remove $n"
    elif [[ $(env_get "$(stack_env "$n")" COMPOSE_PROFILES) != "$(cfg PROFILES)" ]]; then
      warn "'$n' has profiles $(env_get "$(stack_env "$n")" COMPOSE_PROFILES), not config.env's $(cfg PROFILES); run: lolloctl profiles $(cfg PROFILES)"
    fi
  done
}

cmd_apply() {
  local mode=ask a name emails cur d plan=() adds=() changes=() failed=() up=() answer entries
  for a in "$@"; do
    case $a in
      --dry-run) mode=dry ;;
      --yes) mode=yes ;;
      *) die "usage: lolloctl apply [--dry-run|--yes]" ;;
    esac
  done
  require_config
  entries=$(conf_entries)
  if ! (require_initialised) 2>/dev/null; then
    plan+=("init: check the Cloudflare setup and download Lettuce $(cfg LETTUCE_REF)")
  fi
  while read -r name emails; do
    [[ -n $name ]] || continue
    if [[ -z $(env_get "$(stack_env "$name")" CF_DNS_RECORD_ID) ]]; then
      adds+=("$name $emails")
      plan+=("add $name: $emails can sign in")
    else
      cur=$(env_get "$(stack_env "$name")" ALLOWED_USERS)
      d=$(email_diff "$cur" "$emails")
      [[ $d != "- -" ]] || continue
      changes+=("$name $emails")
      plan+=("users $name:$([[ ${d% *} == - ]] || echo " gains ${d% *}")$([[ ${d#* } == - ]] || echo " loses ${d#* }")")
    fi
  done <<<"$entries"
  plan+=("up all, then skills all")

  info "apply ($(stacks_conf)):"
  for a in "${plan[@]}"; do info "  $a"; done
  apply_report "$entries"
  [[ $mode != dry ]] || return 0
  if [[ $mode == ask ]]; then
    stdin_is_terminal || die "not a terminal; run with --yes to apply, or --dry-run to only show the plan"
    printf 'Apply? [y/N] ' >&2
    read -r answer || true
    [[ $answer == [yY] || $answer == [yY][eE][sS] ]] || die "aborted"
  fi

  (require_initialised) 2>/dev/null || cmd_init
  # Each step in a subshell: the commands `die` on failure, and one stack that
  # fails must not keep the others from being set up, started or reported.
  for a in "${adds[@]}"; do
    (cmd_add "${a% *}" "${a#* }") || failed+=("add ${a% *}")
  done
  for a in "${changes[@]}"; do
    (users_update "${a% *}" "${a#* }") || failed+=("users ${a% *}")
  done
  # One up for every stack but those add just started (or failed to set up:
  # they are in `failed` already), so none starts twice.
  for name in $(list_stacks); do
    [[ " ${adds[*]%% *} " == *" $name "* ]] || up+=("$name")
  done
  for name in "${up[@]}"; do
    (up_targets "$name" "$name") || failed+=("up $name")
  done
  if [[ -n $(list_stacks) ]]; then
    (cmd_skills all) || failed+=("skills all")
  fi
  apply_report "$entries"
  ((${#failed[@]} == 0)) ||
    die "apply did not finish: $(printf '%s, ' "${failed[@]}" | sed 's/, $//'); see the messages above, fix the cause, then run apply again"
}

cmd_remove() {
  local name=${1:-} purge="" answer f acc zone id state
  [[ ${2:-} == --purge ]] && purge=1
  [[ -n $name && ($# == 1 || -n $purge) ]] || die "usage: lolloctl remove <name> [--purge]"
  validate_name "$name"
  require_initialised
  require_stack "$name"
  f=$(stack_env "$name")
  acc=$(cfg CF_ACCOUNT_ID)
  zone=$(cfg CF_ZONE_ID)

  info "This stops '$name' and deletes its DNS records, tunnel and Access applications."
  if has_vault "$name"; then
    info "Its vault (the people's saved personal data) is deleted too: its volume goes with the stack."
  fi
  if has_receipts "$name"; then
    info "Its pipelock receipts and their signing key are deleted too; keep a backup if you need them."
  fi
  if has_news_radar "$name"; then
    info "Its monitors, their sources and what they found are deleted too: their volume goes with the stack."
  fi
  if has_volume "$name" browser-data; then
    info "Its browser's kept sign-ins, settings and audit log are deleted too: their volume goes with the stack (no backup holds them)."
  fi
  if has_volume "$name" notifications-data; then
    info "Its notification subscriptions (every device enrolled for the lollo's notifications) are deleted too: their volume goes with the stack."
  fi
  state=$(env_get "$f" LETTA_STATE_DIR)
  if has_profile "$(env_get "$f" COMPOSE_PROFILES)" lollo-gmail-triggers || [[ -n $state && -d $state/lollo/gmail-triggers ]]; then
    info "Its Gmail triggers stop with it; their rules are in its state, so they go only with --purge."
  fi
  if [[ -n $purge && -n $state && -L $state/lollo ]]; then
    # Docker would follow it, and the purge would empty whatever it points at.
    die "$state/lollo is a symlink; remove it by hand, then purge again"
  fi
  if [[ -n $purge ]]; then
    info "--purge also deletes ALL of its data (agents, memory, conversations): $(stack_dir "$name")"
  else
    info "Its data stays in $(stack_dir "$name")."
  fi
  printf 'Type the stack name to confirm: ' >&2
  read -r answer || true
  [[ $answer == "$name" ]] || die "aborted"
  # Dropped first: if Cloudflare keeps something, `apply` reports the stack
  # for another remove instead of setting it up again.
  conf_unset "$name" || die "could not write $(stacks_conf)"

  compose "$name" down -v || warn "docker compose down failed; continuing"
  # The stack's network to the shared Gotenberg; Gotenberg stays for the others.
  # A failure here is repaired by the next sync_doc_tools (`up`, `profiles`).
  if host_docker network inspect "$(doc_tools_network "$name")" >/dev/null 2>&1; then
    drop_doc_tools_network "$(doc_tools_network "$name")" "$(gotenberg_id 2>/dev/null)" ||
      warn "could not remove the network $(doc_tools_network "$name"); 'lolloctl up all' retries"
  fi
  local left=()
  id=$(env_get "$f" CF_DNS_RECORD_ID)
  if [[ -n $id ]]; then
    if cf_api DELETE "/zones/$zone/dns_records/$id" >/dev/null; then env_unset "$f" CF_DNS_RECORD_ID; else left+=("DNS record $id"); fi
  fi
  id=$(env_get "$f" CF_LOLLO_DNS_RECORD_ID)
  if [[ -n $id ]]; then
    if cf_api DELETE "/zones/$zone/dns_records/$id" >/dev/null; then env_unset "$f" CF_LOLLO_DNS_RECORD_ID; else left+=("DNS record $id"); fi
  fi
  id=$(env_get "$f" CF_TUNNEL_ID)
  if [[ -n $id ]]; then
    cf_api DELETE "/accounts/$acc/cfd_tunnel/$id/connections" >/dev/null || true
    if cf_api DELETE "/accounts/$acc/cfd_tunnel/$id" >/dev/null; then
      env_unset "$f" CF_TUNNEL_ID
      env_unset "$f" CLOUDFLARE_TUNNEL_TOKEN
    else
      left+=("tunnel $id")
    fi
  fi
  id=$(env_get "$f" CF_LOLLO_APP_ID)
  if [[ -n $id ]]; then
    if cf_api DELETE "/accounts/$acc/access/apps/$id" >/dev/null; then
      env_unset "$f" CF_LOLLO_APP_ID
      env_unset "$f" CF_LOLLO_AUD
    else
      left+=("Access application $id")
    fi
  fi
  id=$(env_get "$f" CF_ACCESS_APP_ID)
  if [[ -n $id ]]; then
    if cf_api DELETE "/accounts/$acc/access/apps/$id" >/dev/null; then
      env_unset "$f" CF_ACCESS_APP_ID
      env_unset "$f" CF_ACCESS_AUD
    else
      left+=("Access application $id")
    fi
  fi
  id=$(env_get "$f" CF_ACCESS_POLICY_ID)
  if [[ -n $id ]]; then
    if cf_api DELETE "/accounts/$acc/access/policies/$id" >/dev/null; then env_unset "$f" CF_ACCESS_POLICY_ID; else left+=("Access policy $id"); fi
  fi

  if ((${#left[@]})); then
    warn "not deleted (already gone, or delete it in the Cloudflare dashboard): ${left[*]}"
    warn "their ids stay in stacks/$name/stack.env, so 'lolloctl remove $name' can retry"
  fi
  if has_profile "$(cfg PROFILES)" google; then
    info "Google: delete $(google_redirect_uri "$name") from your Google OAuth client's redirect URIs"
  fi
  if [[ -n $purge ]]; then
    if ((${#left[@]})); then
      warn "keeping stacks/$name because Cloudflare resources are left; purge again after they are gone"
      return 0
    fi
    # The state is root-owned (the app-server runs as root), so it is emptied
    # from inside the stack's own image; the empty directories then go without sudo.
    # Gmail trigger rules are outside the app-server's mounts, so they get one here.
    local lollo
    local -a extra=() dirs=(/root/.letta /data /work)
    lollo=$state/lollo
    if [[ -n $state && -d $lollo ]]; then
      extra=(-v "$lollo:/lollo")
      dirs+=(/lollo)
    fi
    # Rendered without doc-tools: the app-server's doc-tools image and network
    # are not needed to empty the state, and the network is gone already.
    local renv
    renv=$(env_without_profile "$f" lollo-doc-tools)
    compose_env "$renv" "$name" run --rm --no-deps -T "${extra[@]}" --entrypoint find app-server \
      "${dirs[@]}" -mindepth 1 -delete || {
      rm -f "$renv"
      die "could not empty the state of '$name'"
    }
    # `run` recreated the project network; remove it again before the env file goes.
    compose_env "$renv" "$name" down || warn "could not remove the network of '$name'"
    rm -f "$renv"
    rm -rf "$(stack_dir "$name")"
    info "'$name' removed, data included"
  else
    info "'$name' removed from Cloudflare; data kept in $(stack_dir "$name")"
  fi
}

cmd_profiles() {
  (($# <= 1)) || die "usage: lolloctl profiles [<profile>,<profile>...]"
  local new n changed="" stale running docs=1 rc kept=0
  local -a stacks gone failed=() unrouted=() executors=() undropped=() unstarted=()
  mapfile -t stacks < <(list_stacks)
  if (($# == 0)); then
    require_config
    printf '%-20s %s\n' config.env "$(cfg PROFILES)"
    for n in "${stacks[@]}"; do
      printf '%-20s %s\n' "$n" "$(env_get "$(stack_env "$n")" COMPOSE_PROFILES)"
    done
    return 0
  fi
  require_initialised
  new=$(normalise_profiles "$1")
  [[ $(cfg PROFILES) == "$new" ]] || changed=1
  for n in "${stacks[@]}"; do
    [[ $(env_get "$(stack_env "$n")" COMPOSE_PROFILES) == "$new" ]] || changed=1
  done

  # Every run syncs the executor on running stacks, so each needs its token,
  # also when the list is unchanged (a deleted token is made again).
  # The notifications service's keys and tokens, and the browser's secret,
  # likewise, so a list that turns a sender on passes check_stack on a stack
  # made before them.
  for n in "${stacks[@]}"; do
    ensure_executor_token "$n"
    ensure_notify_secrets "$n"
    ensure_browser_secrets "$n"
  done

  if [[ -n $changed ]]; then
    # Check every stack, as it will be under the new list, before writing
    # anything, so one broken stack cannot leave the others half-switched. The
    # push contact too: every stack's up keeps it in step.
    push_contact >/dev/null
    for n in "${stacks[@]}"; do
      check_stack "$n" --profiles "$new"
    done
    for n in "${stacks[@]}"; do
      env_set "$(stack_env "$n")" COMPOSE_PROFILES "$new"
    done
    env_set "$(config_file)" PROFILES "$new"
    info "profiles for every stack: $new"
  fi

  # The tunnel routes each lollo page only with its profile, on the lollo
  # host. Applied on every run, before the stacks start, so a re-run repairs a
  # failed update.
  for n in "${stacks[@]}"; do
    route_stack "$n" || unrouted+=("$n")
  done

  # One stack that does not start (the browser's sandbox refused by the host,
  # a failed build) must not keep the others from starting: the lists are
  # written already, so a re-run would find nothing to change. Each failure is
  # reported at the end, with the `up` that starts it. Not `(up_stack) ||`,
  # which would turn errexit off inside it.
  if [[ -n $changed ]]; then
    for n in "${stacks[@]}"; do
      set +e
      (
        set -e
        up_stack "$n"
      )
      rc=$?
      set -e
      ((rc == 0)) || unstarted+=("$n")
    done
  else
    info "profiles are already $new everywhere; nothing to change"
  fi

  # Compose leaves the containers of a dropped profile running. This looks at
  # what exists rather than at what changed, so a re-run also clears what an
  # interrupted run left behind.
  # A stack that did not start keeps them: its old app-server still runs, with
  # their servers in Settings -> MCP and its executor, which its `up` syncs;
  # removing them first would fail every `letta mcp tools` call until then.
  # The same command, run again after that `up`, removes them.
  for n in "${stacks[@]}"; do
    stale=$(stale_services "$n")
    [[ -n $stale ]] || continue
    mapfile -t gone <<<"$stale"
    if [[ " ${unstarted[*]} " == *" $n "* ]]; then
      info "$n: keeping ${gone[*]} (their profile is off) until it starts"
      kept=1
      continue
    fi
    info "$n: removing ${gone[*]} (their profile is off)"
    compose "$n" rm -sf "${gone[@]}" || failed+=("$n")
  done
  # The executor follows the profile on every running stack, on every run, so a
  # re-run repairs a failed install or removal; a stopped stack gets it right
  # at its next `up`.
  # A stack that did not start gets both at its `up`.
  for n in "${stacks[@]}"; do
    [[ " ${unstarted[*]} " != *" $n "* ]] || continue
    if ! executor_wanted "$new" && ! executor_installed "$n"; then
      continue
    fi
    running=$(compose "$n" ps --status running --services) || {
      executors+=("$n")
      continue
    }
    if ! grep -qx app-server <<<"$running"; then
      if executor_wanted "$new"; then
        info "$n: not running; its executor is installed at its next up"
      else
        info "$n: not running; its executor is removed at its next up"
      fi
      continue
    fi
    sync_executor "$n" || executors+=("$n")
  done
  # Gotenberg and the networks follow the profile on every run too, and so do
  # the servers registered in Settings -> MCP.
  sync_doc_tools || docs=0
  for n in "${stacks[@]}"; do
    [[ " ${unstarted[*]} " != *" $n "* ]] || continue
    drop_mcp_servers "$n" || undropped+=("$n")
  done

  if has_profile "$new" google; then
    for n in "${stacks[@]}"; do
      google_reminder "$n"
    done
  fi
  if [[ -n $changed ]]; then
    for n in "${stacks[@]}"; do
      mcp_reminder "$n" "$new"
    done
  fi
  ((${#unrouted[@]} == 0)) || warn "could not update the tunnel routes or Access application of: ${unrouted[*]}"
  ((${#failed[@]} == 0)) || warn "could not remove the containers of dropped profiles in: ${failed[*]}"
  ((${#executors[@]} == 0)) || warn "could not sync the lollo executor of: ${executors[*]}"
  ((docs)) || warn "could not sync the document tools (shared Gotenberg, networks)"
  ((${#undropped[@]} == 0)) || warn "could not remove servers whose profile is off from Settings -> MCP in: ${undropped[*]}"
  if ((${#unstarted[@]})); then
    # `up` takes one stack or all of them.
    n=all
    ((${#unstarted[@]} > 1)) || n=${unstarted[0]}
    warn "the profiles are set, but these stacks did not start: ${unstarted[*]} (see the messages above)"
    ((kept + ${#unrouted[@]} + ${#failed[@]} + ${#executors[@]} + ${#undropped[@]} == 0 && docs)) ||
      die "fix the cause, then run: lolloctl up $n, then the same command again"
    die "fix the cause, then run: lolloctl up $n"
  fi
  ((${#unrouted[@]} + ${#failed[@]} + ${#executors[@]} + ${#undropped[@]} == 0 && docs)) || die "run the same command again"
}

cmd_upgrade() {
  (($# == 1)) || die "usage: lolloctl upgrade <tag>"
  local ref=$1
  require_initialised
  fetch_upstream "$ref"
  env_set "$(config_file)" LETTUCE_REF "$ref"
  warn_untested_ref
  sync_upstream_images
  info "Lettuce now at $ref; updating every stack"
  cmd_up all
  prune_upstream "$ref"
}

# warn_untested_ref -> in release mode, says when LETTUCE_REF is not the tag this
# release was tested with
warn_untested_ref() {
  local tested
  release_mode || return 0
  tested=$(release_get LETTUCE_REF)
  [[ $(cfg LETTUCE_REF) == "$tested" ]] ||
    warn "Lettuce $(cfg LETTUCE_REF) is not the version lollo-rozzo $(release_get VERSION) was tested with ($tested); walk the upgrade checklist (CONTRIBUTING.md, Upgrading LETTUCE_REF)"
}

cmd_up() {
  (($# == 1)) || die "usage: lolloctl up <name|all>"
  require_initialised
  # shellcheck disable=SC2046 # stack names are single words (validate_name)
  up_targets "$1" $(expand_targets "$1")
}

# up_targets HINT NAME... -> `up` for these stacks; HINT is what to re-run
# (`lolloctl up HINT`) when something is out of step
up_targets() {
  local hint=$1 n unsynced=() undropped=() docs=1
  shift
  for n in "$@"; do
    up_stack "$n"
    sync_executor "$n" || unsynced+=("$n")
    drop_mcp_servers "$n" || undropped+=("$n")
  done
  sync_doc_tools || docs=0
  ((${#unsynced[@]} == 0)) || executor_out_of_step "${unsynced[@]}"
  ((${#undropped[@]} == 0)) || warn "could not remove servers whose profile is off from Settings -> MCP in: ${undropped[*]}; run: lolloctl up $hint"
  ((docs)) || die "the document tools (shared Gotenberg, networks) are out of step; fix the cause, then run: lolloctl up $hint"
  ((${#undropped[@]} == 0)) || die "servers whose profile is off are still in Settings -> MCP"
}

cmd_down() {
  (($# == 1)) || die "usage: lolloctl down <name|all>"
  local n targets
  targets=$(expand_targets "$1")
  for n in $targets; do
    compose "$n" down
  done
}

cmd_restart() {
  (($# == 1)) || die "usage: lolloctl restart <name|all>"
  # Before anything stops: cmd_down checks nothing, and cmd_up would refuse.
  require_initialised
  cmd_down "$1"
  cmd_up "$1"
}

cmd_check() {
  (($# == 1)) || die "usage: lolloctl check <name|all>"
  local n targets
  require_initialised
  targets=$(expand_targets "$1")
  for n in $targets; do
    check_stack "$n"
    info "$n: ok"
  done
}

cmd_status() {
  local n
  while read -r n; do
    printf '== %s  https://%s\n' "$n" "$(env_get "$(stack_env "$n")" LETTUCE_HOSTNAME)"
    compose "$n" ps --format 'table {{.Service}}\t{{.Status}}'
    audit_summary "$n"
  done < <(list_stacks)
}

cmd_list() {
  local n f lollo
  while read -r n; do
    f=$(stack_env "$n")
    lollo=$(env_get "$f" LOLLO_HOSTNAME)
    printf '%-20s https://%-40s %-48s %s\n' "$n" "$(env_get "$f" LETTUCE_HOSTNAME)" "${lollo:+https://$lollo/}" \
      "$(env_get "$f" ALLOWED_USERS)"
  done < <(list_stacks)
}

cmd_logs() {
  (($# >= 1)) || die "usage: lolloctl logs <name> [service]"
  validate_name "$1"
  require_stack "$1"
  compose "$1" logs -f --tail=200 "${@:2}"
}

cmd_compose() {
  (($# >= 2)) || die "usage: lolloctl compose <name> <args...>"
  validate_name "$1"
  require_stack "$1"
  compose "$@"
}

# The shape of an agent id, as the landing service checks it. An id read from the
# app-server, where agents are root, is used in paths only once it matches.
AGENT_ID_RE='^agent-[A-Za-z0-9-]{1,80}$'

# find_agent NAME AGENT -> "<id>\t<name>" of the stack's agent whose id, or name
# ignoring case, is AGENT; dies when none or several match, or when the id it
# found is not an agent id
find_agent() {
  local list matches n id
  # letta exits before flushing a pipe past 64 KiB, and each agent carries its
  # whole system prompt, so the list goes through a file in the container.
  # stdin stays for the shell: `compose exec` would forward it here.
  # shellcheck disable=SC2016 # expanded by sh in the container
  list=$(inert_stderr compose "$1" exec -T app-server sh -c \
    'f=$(mktemp); letta agents list --limit 1000 >"$f"; rc=$?; cat "$f"; rm -f "$f"; exit $rc' </dev/null) ||
    die "$1: could not list agents (is the stack up?)"
  matches=$(jq -c --arg a "$2" \
    '[.items[] | select(.id == $a or (.name | ascii_downcase) == ($a | ascii_downcase)) | {id: (.id | tostring), name: (.name | tostring)}]' \
    <<<"$list") || die "$1: unexpected output from 'letta agents list'"
  n=$(jq length <<<"$matches")
  case $n in
    0) die "$1 has no agent '$(printable "$2")'; agents: $(printable "$(jq -r '[.items[].name | tostring] | join(", ")' <<<"$list")")" ;;
    1) ;;
    *) die "$1 has several agents named '$(printable "$2")'; use an id: $(printable "$(jq -r 'map(.id) | join(" ")' <<<"$matches")")" ;;
  esac
  id=$(jq -r '.[0].id' <<<"$matches")
  [[ $id =~ $AGENT_ID_RE ]] ||
    die "$1: the app-server gave an unexpected agent id '$(printable "$id")'; refusing to use it"
  printf '%s\t%s' "$id" "$(jq -r '.[0].name' <<<"$matches")"
}

# open_agent NAME AGENT -> sets the caller's id, ws (the workspace on the host),
# wsdir (the workspaces directory that holds it) and agent_env (what letta-code
# sets for the agent's Bash tool, as -e options); dies when the agent or its
# workspace does not exist, or when either is a symbolic link
open_agent() {
  local agent agent_name
  agent=$(find_agent "$1" "$2")
  id=${agent%%$'\t'*}
  agent_name=${agent#*$'\t'}
  wsdir=$(env_get "$(stack_env "$1")" LETTA_STATE_DIR)/workspaces
  ws=$wsdir/$id
  # An agent can replace its workspace, or (as root in the app-server) the
  # directory, with a link to anywhere on the host.
  [[ ! -L $wsdir ]] || die "$1: $wsdir is a symbolic link; refusing to open it"
  [[ ! -L $ws ]] || die "$1: the workspace of $(printable "$agent_name") at $ws is a symbolic link; refusing to open it"
  [[ -d $ws ]] || die "$1: no workspace for $(printable "$agent_name") at $ws"
  agent_env=(-e "AGENT_ID=$id" -e "LETTA_AGENT_ID=$id" -e "AGENT_NAME=$agent_name" -e "USER_CWD=/work/$id")
  info "$1: $(printable "$agent_name") ($id)"
}

# Close to, not the same as, an agent's Bash tool: letta-code also sets the
# conversation id, per-agent secrets and a few PATH entries.
cmd_shell() {
  (($# == 1 || $# == 2)) || die "usage: lolloctl shell <name> [agent]"
  validate_name "$1"
  require_stack "$1"
  local tty=() id ws wsdir agent_env=()
  [[ -t 0 && -t 1 ]] || tty=(-T)
  if (($# == 1)); then
    compose "$1" exec "${tty[@]}" -w /work app-server bash
    return
  fi
  open_agent "$1" "$2"
  # The memory path is letta-code's local-backend layout (getLocalBackendMemoryFilesystemRoot).
  # shellcheck disable=SC2016 # expanded by bash in the container
  compose "$1" exec "${tty[@]}" -w "/work/$id" "${agent_env[@]}" \
    app-server bash -c 'export MEMORY_DIR=$LETTA_LOCAL_BACKEND_DIR/memfs/$AGENT_ID/memory
export LETTA_MEMORY_DIR=$MEMORY_DIR
exec bash'
}

# ── toolbox ──────────────────────────────────────────────────────────────────
# `toolbox` works on an agent's workspace with the operator's own tools from a
# throwaway container. Agents run in the app-server, so unlike `shell` nothing it
# brings in is visible to them. The helpers below add to cmd_toolbox's arrays.
# The agents' installed tools are mounted only with --tools (read-only unless rw):
# every agent writes them, and here they would run with the operator's credentials.

# host_home -> the operator's home on the host. In release mode lolloctl's own
# HOME is a scratch directory in its container, and the wrapper mounts the
# operator's home read-only at the same path and names it here.
host_home() { printf '%s' "${LOLLOCTL_HOST_HOME:-$HOME}"; }

toolbox_file() { printf '%s/lolloctl/toolbox' "${XDG_CONFIG_HOME:-$(host_home)/.config}"; }

# tilde PATH HOME -> PATH with a leading ~ replaced by HOME
tilde() {
  # shellcheck disable=SC2088 # matching a literal ~ from the toolbox file
  case $1 in
    "~") printf '%s' "$2" ;;
    "~/"*) printf '%s/%s' "$2" "${1#"~/"}" ;;
    *) printf '%s' "$1" ;;
  esac
}

# toolbox_mount SRC DEST ro|rw
toolbox_mount() {
  local real
  [[ -e $1 ]] || die "toolbox: $1 does not exist$(release_mode && echo " (in release mode, toolbox mounts must be under $(host_home), which the wrapper mounts)")"
  [[ $1 == /* && $2 == /* ]] || die "toolbox: mount paths must be absolute: $1 $2"
  [[ $1$2 != *:* ]] || die "toolbox: mount paths cannot contain ':': $1 $2"
  # The data directory holds every stack's secrets, and it may be under the home
  # (~/lollo-rozzo), where `mount ~`, or a file linked into it, would hand it to
  # an agent's workspace.
  real=$(realpath -m -- "$1")
  if inside "$real" "$LOLLO_DATA" || inside "$LOLLO_DATA" "$real"; then
    die "toolbox: a toolbox mount cannot hold the data directory $LOLLO_DATA: $1"
  fi
  run+=(-v "$1:$2:$3")
}

# toolbox_secret NAME VALUE -> passed to the container by name, never in argv; a
# later value for the same NAME replaces the earlier one
toolbox_secret() {
  local i
  for i in "${!secret_names[@]}"; do
    if [[ ${secret_names[i]} == "$1" ]]; then
      secret_values[i]=$2
      return
    fi
  done
  secret_names+=("$1")
  secret_values+=("$2")
}

# The operator's credentials, each brought in only when chosen: by its flag
# (--gh, --ssh, --claude) or by a `use` line in the toolbox file. gh is the
# GitHub token and git's credential helper, ssh the ssh-agent, claude the
# Claude token and Claude Code's config (its settings.json can hold secrets and
# hooks). The agent wrote the workspace, so nothing is brought in by default.
TOOLBOX_KINDS="gh ssh claude"

# toolbox_chosen KIND -> success when the run brings in KIND (cmd_toolbox's
# flag_kinds, plus file_kinds unless --no-credentials)
toolbox_chosen() {
  [[ " $flag_kinds " == *" $1 "* ]] || { [[ -z $no_credentials && " $file_kinds " == *" $1 "* ]]; }
}

# Git settings the toolbox always passes in command scope, which beats the
# repository's own config for these keys: whatever the workspace holds, and
# with --trust-workspace too, git runs no fsmonitor, no hook, no ssh command,
# no credential helper and no ext:: transport of the agent's (an empty
# credential.helper empties the list the repository's config built).
# --trust-workspace means "start anyway", not "run my hooks":
# `git -c core.hooksPath=.git/hooks ...` does that.
TOOLBOX_GIT_CONFIG=(
  core.fsmonitor=false
  core.hooksPath=/dev/null
  core.sshCommand=ssh
  protocol.ext.allow=never
  core.pager=less
  credential.helper=
)

# toolbox_git_config -> the forced settings, then gh's credential helper when
# gh is chosen (the host's helper may call gh by a path the image lacks), as
# GIT_CONFIG_COUNT/KEY/VALUE options; and git never looks for a repository in
# /work itself, which every agent can write
toolbox_git_config() {
  local kv=("${TOOLBOX_GIT_CONFIG[@]}") i
  run+=(-e GIT_CEILING_DIRECTORIES=/work)
  if toolbox_chosen gh; then
    kv+=(credential.https://github.com.helper= "credential.https://github.com.helper=!gh auth git-credential")
  fi
  run+=(-e "GIT_CONFIG_COUNT=${#kv[@]}")
  for i in "${!kv[@]}"; do
    run+=(-e "GIT_CONFIG_KEY_$i=${kv[i]%%=*}" -e "GIT_CONFIG_VALUE_$i=${kv[i]#*=}")
  done
}

# toolbox_builtins -> what the operator gets from the host: their git and ssh
# configuration always, read-only, and each credential only when chosen and
# the host has it
toolbox_builtins() {
  local home claude f tok found=""
  home=$(host_home)
  claude=${CLAUDE_CONFIG_DIR:-$home/.claude}
  if [[ -f $home/.ssh/known_hosts ]]; then
    toolbox_mount "$home/.ssh/known_hosts" /root/.ssh/known_hosts ro
  fi
  if [[ -f $home/.gitconfig ]]; then
    toolbox_mount "$home/.gitconfig" /root/.gitconfig ro
    have+=(git)
  fi
  if toolbox_chosen ssh && [[ -n ${SSH_AUTH_SOCK:-} && -e $SSH_AUTH_SOCK ]]; then
    run+=(-v "$SSH_AUTH_SOCK:/run/ssh-agent.sock" -e SSH_AUTH_SOCK=/run/ssh-agent.sock)
    have+=(ssh-agent)
  fi
  # In release mode the wrapper runs gh and secret-tool on the host, for chosen
  # kinds only, and passes what they print by name (LOLLOCTL_GH_TOKEN,
  # LOLLOCTL_CLAUDE_TOKEN).
  if toolbox_chosen gh; then
    tok=${LOLLOCTL_GH_TOKEN:-}
    if [[ -n $tok ]] || { command -v gh >/dev/null && tok=$(gh auth token 2>/dev/null </dev/null) && [[ -n $tok ]]; }; then
      toolbox_secret GH_TOKEN "$tok"
      have+=(gh)
    fi
  fi
  toolbox_chosen claude || return 0
  for f in CLAUDE.md settings.json skills agents commands; do
    if [[ -e $claude/$f ]]; then
      toolbox_mount "$claude/$f" "/root/.claude/$f" ro
      found=1
    fi
  done
  [[ -z $found ]] || have+=("claude config")
  tok=${CLAUDE_CODE_OAUTH_TOKEN:-${LOLLOCTL_CLAUDE_TOKEN:-}}
  if [[ -z $tok ]] && command -v secret-tool >/dev/null; then
    tok=$(secret-tool lookup service claude-toolbox 2>/dev/null </dev/null) || tok=""
  fi
  if [[ -n $tok ]]; then
    toolbox_secret CLAUDE_CODE_OAUTH_TOKEN "$tok"
    have+=("claude token")
  fi
}

# toolbox_personal FILE PASS -> the operator's own additions; parsed, never sourced.
# One per line, words split on spaces:
#   use KIND...                 bring in these credentials (gh, ssh, claude) on every run
#   mount SRC [DEST] [rw]       read-only unless rw; DEST defaults to SRC
#   secret NAME COMMAND [ARG]   NAME is set to the command's output, by name only
#   env NAME=VALUE              a plain variable
# ~ is the operator's home in SRC and commands, and /root in DEST.
# PASS `use` reads only the use lines, into file_kinds, before the built-in
# credentials are chosen; PASS `all` does the rest.
toolbox_personal() {
  local file=$1 pass=$2 line w a k n=0 src dest mode val name
  [[ -f $file ]] || return 0
  # In release mode the wrapper checked the owner on the host, where it is real;
  # here a macOS share may report another (check_mounts).
  release_mode || [[ -O $file ]] || die "$file is not owned by you"
  ((((8#$(file_mode "$file")) & 8#022) == 0)) || die "$file is writable by others (chmod 600 $file)"
  while IFS= read -r line || [[ -n $line ]]; do
    read -ra w <<<"$line"
    [[ ${#w[@]} == 0 || ${w[0]} == \#* ]] && continue
    if [[ ${w[0]} == use ]]; then
      [[ $pass == use ]] || continue
      ((${#w[@]} >= 2)) || die "$file: expected 'use KIND...' (KIND: ${TOOLBOX_KINDS// /, }): $line"
      for k in "${w[@]:1}"; do
        [[ " $TOOLBOX_KINDS " == *" $k "* ]] || die "$file: unknown credential '$k' (use: ${TOOLBOX_KINDS// /, }): $line"
        file_kinds+=" $k"
      done
      continue
    fi
    [[ $pass == all ]] || continue
    case ${w[0]} in
      mount)
        a=("${w[@]:1}")
        mode=ro
        if ((${#a[@]} > 1)) && [[ ${a[-1]} == rw ]]; then
          mode=rw
          unset 'a[-1]'
        fi
        ((${#a[@]} == 1 || ${#a[@]} == 2)) || die "$file: expected 'mount SRC [DEST] [rw]': $line"
        src=$(tilde "${a[0]}" "$(host_home)")
        dest=$src
        [[ -z ${a[1]:-} ]] || dest=$(tilde "${a[1]}" /root)
        toolbox_mount "$src" "$dest" "$mode"
        ;;
      secret)
        name=${w[1]:-}
        ((${#w[@]} >= 3)) && [[ $name =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] ||
          die "$file: expected 'secret NAME COMMAND [ARG...]': $line"
        if release_mode; then
          # The command is the host's: the wrapper ran it there (lolloctl-wrapper.sh).
          a=(LOLLOCTL_SECRET_"$name")
          val=${!a:-}
          [[ -n $val ]] || die "$file: secret $name: the wrapper passed no value; it runs 'secret' lines on the host"
          toolbox_secret "$name" "$val"
          n=$((n + 1))
          continue
        fi
        a=()
        for val in "${w[@]:2}"; do a+=("$(tilde "$val" "$HOME")"); done
        val=$("${a[@]}" </dev/null) || die "$file: secret $name: '${a[*]}' failed"
        [[ -n $val ]] || die "$file: secret $name: '${a[*]}' printed nothing"
        toolbox_secret "$name" "$val"
        ;;
      env)
        ((${#w[@]} == 2)) && [[ ${w[1]} =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] ||
          die "$file: expected 'env NAME=VALUE': $line"
        run+=(-e "${w[1]}")
        ;;
      *) die "$file: unknown directive '${w[0]}': $line" ;;
    esac
    n=$((n + 1))
  done <"$file"
  ((n == 0)) || have+=("+$n from $file")
}

# How deep the workspace scan looks, and how many entries it reads before it
# calls itself incomplete (which refuses like a finding). Agents keep several
# repositories in one workspace, and git and Claude Code run in subdirectories.
TOOLBOX_SCAN_DEPTH=6
TOOLBOX_SCAN_ENTRIES=50000

# Run by bash in a throwaway container of the app-server's image as:
#   bash -s -- ROOT DEPTH ENTRIES  (this text on stdin)
# with the workspaces mounted read-only, no network, no credential and no
# capability but reading. Prints its findings, NUL-separated: configuration in
# the workspace ROOT that runs code when git, Claude Code, direnv or npm is
# used there. It only reads and parses files, with git's own parser for git's
# config (`--file` ignores include.*), and never follows a symbolic link: a
# link where a file would be read is a finding itself. The allow-list of git
# keys is what a clone, a fetch, a pull and a push write; widening it is a
# reviewed change.
# shellcheck disable=SC2016 # expanded by bash in the container
TOOLBOX_SCAN='set -uf
root=$1 depth=$2 cap=$3 secs=${4:-60} insub=""
# Folders the depth-limited walk skips: dependencies, builds, caches and git
# directories, which hold many files and no configuration a tool reads from
# there. Repositories are searched for in them too (below).
pruned=(\( -name node_modules -o -name .venv -o -name venv -o -name vendor -o -name target -o -name build -o -name dist
  -o -name .next -o -name __pycache__ -o -name .cache -o -name .tox -o -name .gradle -o -name .mypy_cache -o -name .git \) -prune)
export GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null HOME=/nonexistent
# git looks for a repository from the working directory even with --file, and
# one the workspace planted there must not decide how a file is read.
cd /
nl=$(printf "\nx")
nl=${nl%x}
say() { printf "%s\0" "$1"; }
rel() { if [[ $1 == "$root" ]]; then printf .; else printf "%s" "${1#"$root"/}"; fi; }
allowed() {
  case $1 in
    core.repositoryformatversion | core.filemode | core.bare | core.logallrefupdates | core.ignorecase | \
      core.precomposeunicode | core.symlinks | core.autocrlf | core.eol) return 0 ;;
    remote.*.url | remote.*.pushurl | remote.*.fetch | remote.*.tagopt | remote.*.prune) return 0 ;;
    remote.*.gh-resolved | remote.*.promisor | remote.*.partialclonefilter | extensions.partialclone) return 0 ;;
    core.sparsecheckout | core.sparsecheckoutcone | index.sparse | submodule.*.url | submodule.*.active) return 0 ;;
    # The toolbox forces core.hooksPath, so husky and the like setting it is harmless.
    core.hookspath) return 0 ;;
    # Every submodule git directory names its work tree; a repository of the
    # workspace naming one (/root, say) is a finding.
    core.worktree) [[ -n $insub ]] && return 0 ;;
    branch.*.remote | branch.*.merge | branch.*.rebase | branch.*.pushremote) return 0 ;;
    user.name | user.email | pull.* | push.default | push.autosetupremote | init.defaultbranch | fetch.prune) return 0 ;;
    extensions.objectformat | extensions.worktreeconfig | lfs.repositoryformatversion) return 0 ;;
  esac
  return 1
}
# readable FILE -> success when FILE is a regular file to parse; a link, or
# anything else where a file should be, is a finding
readable() {
  [[ -e $1 || -L $1 ]] || return 1
  if [[ -L $1 ]]; then
    say "$(rel "$1"): a symbolic link, not read"
    return 1
  fi
  [[ -f $1 ]] && return 0
  say "$(rel "$1"): not a regular file, not read"
  return 1
}
project() {
  local p
  for p in .claude .mcp.json .envrc .npmrc; do
    [[ ! -e $1/$p && ! -L $1/$p ]] || say "$(rel "$1/$p"): project configuration that a tool runs or loads"
  done
}
gitconfig() {
  local f=$1 keys k kv v
  readable "$f" || return 0
  keys=$(git config --file "$f" --name-only --list 2>/dev/null) || {
    say "$(rel "$f"): git could not parse it"
    return 0
  }
  while IFS= read -r k; do
    [[ -z $k ]] || allowed "$k" || say "$(rel "$f"): $k"
  done <<<"$keys"
  while IFS= read -r -d "" kv; do
    v=${kv#*"$nl"}
    case $v in ext::* | fd::*) say "$(rel "$f"): a remote URL with the ${v%%::*}:: transport" ;; esac
  done < <(git config --file "$f" -z --get-regexp "^remote\..*\.(url|pushurl)$" 2>/dev/null)
}
attrs() {
  local f=$1 line w first
  readable "$f" || return 0
  while IFS= read -r line || [[ -n $line ]]; do
    [[ $line =~ ^[[:space:]]*(#|$) ]] && continue
    first=1
    for w in $line; do
      if ((first)); then
        first=0
        continue
      fi
      case $w in
        # Git LFS names its own drivers, which only the operator configures.
        filter=*) [[ ${w#*=} == lfs ]] || say "$(rel "$f"): $w" ;;
        diff=* | merge=*)
          case ${w#*=} in binary | text | union | lfs) ;; *) say "$(rel "$f"): $w" ;; esac
          ;;
      esac
    done
  done <"$f"
}
modules() {
  local f=$1 keys k
  readable "$f" || return 0
  keys=$(git config --file "$f" --name-only --list 2>/dev/null) || {
    say "$(rel "$f"): git could not parse it"
    return 0
  }
  while IFS= read -r k; do
    case $k in submodule.*.update) say "$(rel "$f"): $k" ;; esac
  done <<<"$keys"
}
# inside DIR PATH -> prints PATH, absolute or relative to DIR as git writes a
# gitdir or commondir, made absolute without reading any link; fails unless it
# lies in the workspace with no symbolic link on the way
inside() {
  local p=$2 q=$root part
  local -a parts
  [[ $p == /* ]] || p=$1/$p
  p=$(realpath -s -m -- "$p") || return 1
  [[ $p == "$root"/* ]] || return 1
  IFS=/ read -r -a parts <<<"${p#"$root"/}"
  for part in "${parts[@]}"; do
    q=$q/$part
    [[ ! -L $q ]] || return 1
  done
  printf "%s" "$p"
}
# gitdir DIR -> the configuration a git directory holds. Hooks are not read:
# the toolbox forces core.hooksPath, so none of them runs there.
gitdir() {
  gitconfig "$1/config"
  gitconfig "$1/config.worktree"
  attrs "$1/info/attributes"
}
repo() {
  local g=$1 r=${1%/.git} d line t
  [[ $r == "$root" ]] || project "$r"
  modules "$r/.gitmodules"
  attrs "$r/.gitattributes"
  if [[ -L $g ]]; then
    say "$(rel "$g"): a symbolic link, not read"
    return 0
  fi
  if [[ -f $g ]]; then
    # A submodule or a linked worktree: its git directory sits in the
    # repository holding it, under .git/modules or .git/worktrees, which the
    # scan of that repository reads (below).
    line=""
    IFS= read -r line <"$g" || :
    if [[ $line == "gitdir: "* ]] && t=$(inside "$r" "${line#gitdir: }") &&
      [[ ($t == */.git/modules/* || $t == */.git/worktrees/*) && -d $t ]]; then
      return 0
    fi
    say "$(rel "$g"): a git file naming another directory, whose configuration was not read"
    return 0
  fi
  [[ -d $g ]] || return 0
  gitdir "$g"
  [[ ! -e $g/commondir && ! -L $g/commondir ]] ||
    say "$(rel "$g/commondir"): takes its configuration from another directory, not read"
  # Submodules and linked worktrees: their git directories, each with a HEAD.
  # A worktree takes the rest of its configuration from this one (commondir).
  while IFS= read -r -d "" d; do
    d=${d%/HEAD}
    insub=1
    gitdir "$d"
    insub=""
    if [[ -e $d/commondir || -L $d/commondir ]]; then
      line=""
      [[ -L $d/commondir ]] || IFS= read -r line <"$d/commondir" || :
      if ! t=$(inside "$d" "$line") || [[ $t != "$g" ]]; then
        say "$(rel "$d/commondir"): takes its configuration from another directory, not read"
      fi
    fi
  done < <(find -P "$g/modules" "$g/worktrees" -name HEAD -type f -print0 2>/dev/null)
}
if [[ -L $root || ! -d $root ]]; then
  say ".: not a directory"
  exit 3
fi
n=$(find -P "$root" -maxdepth "$depth" "${pruned[@]}" -o -print |
  head -n "$((cap + 1))" | wc -l)
if ((n > cap)); then
  say ".: more than $cap entries, so the scan is incomplete"
  exit 4
fi
project "$root"
# The workspaces directory itself: git, Claude Code and direnv look upwards
# from a workspace, and every agent can write there. (The toolbox also stops
# git there with GIT_CEILING_DIRECTORIES.)
up=${root%/*}
for p in .git .gitattributes .gitmodules .claude .mcp.json .envrc .npmrc; do
  [[ ! -e $up/$p && ! -L $up/$p ]] || say "$up/$p: in the workspaces directory, above every workspace"
done
# Repositories at any depth, in node_modules, .venv and vendor too: git reads
# the configuration of whichever one it is used in. This search only lists
# names, so a time limit bounds it, not the entry cap. Its exit status comes
# last, as a record no path can be (every path starts with the root).
repos=0 found=""
while IFS= read -r -d "" p; do
  case $p in
    "?rc="*)
      found=${p#"?rc="}
      continue
      ;;
  esac
  if ((++repos > cap)); then
    say ".: more than $cap repositories, so the scan is incomplete"
    exit 4
  fi
  repo "$p"
done < <(
  timeout "$secs" find -P "$root" -name .git -prune -print0
  printf "?rc=%s\0" "$?"
)
# 1 is find reading on past a folder that went away (a build, say).
case $found in
  0 | 1) ;;
  124 | 137)
    say ".: the search for repositories did not finish in $secs seconds, so the scan is incomplete"
    exit 4
    ;;
  *)
    say ".: the search for repositories failed (exit $found), so the scan is incomplete"
    exit 4
    ;;
esac
# .gitattributes files, but those at a repository root: repo read them above.
while IFS= read -r -d "" p; do
  [[ -e ${p%/*}/.git || -L ${p%/*}/.git ]] || attrs "$p"
done < <(find -P "$root" -maxdepth "$depth" "${pruned[@]}" -o -name .gitattributes -print0)'

# toolbox_scan NAME -> looks at the agent's workspace, in a throwaway container
# of the app-server's image (cmd_toolbox's image, mask, wsdir and id), and sets
# findings: what in it would run code on ordinary use. The container has no
# network, no credential, a read-only root and the workspaces read-only, and it
# resolves links inside itself, never on the host. A failed or incomplete scan
# is a finding too.
toolbox_scan() {
  local out f rc=0
  findings=()
  out=$(mktemp) || die "toolbox: could not make a temporary file"
  host_docker run --rm -i --network none --read-only --cap-drop ALL --cap-add DAC_READ_SEARCH \
    --security-opt no-new-privileges --label "lolloctl.toolbox-scan=$1" "${mask[@]}" \
    -v "$wsdir:/work:ro" --entrypoint bash "$image" -s -- "/work/$id" "$TOOLBOX_SCAN_DEPTH" "$TOOLBOX_SCAN_ENTRIES" \
    <<<"$TOOLBOX_SCAN" >"$out" 2>/dev/null || rc=$?
  while IFS= read -r -d '' f || [[ -n $f ]]; do findings+=("$f"); done <"$out"
  rm -f "$out"
  ((rc == 0)) || findings+=("the workspace scan failed (exit $rc), so it is incomplete")
}

cmd_toolbox() {
  local usage="usage: lolloctl toolbox [--gh] [--ssh] [--claude] [--no-credentials] [--trust-workspace] [--tools[=rw]] <name> <agent> [command...]"
  local tools="" trust="" no_credentials="" flag_kinds="" file_kinds=""
  while [[ ${1:-} == --* ]]; do
    case $1 in
      --tools) tools=ro ;;
      --tools=rw) tools=rw ;;
      --gh) flag_kinds+=" gh" ;;
      --ssh) flag_kinds+=" ssh" ;;
      --claude) flag_kinds+=" claude" ;;
      --no-credentials) no_credentials=1 ;;
      --trust-workspace) trust=1 ;;
      *) die "$usage" ;;
    esac
    shift
  done
  (($# >= 2)) || die "$usage"
  validate_name "$1"
  require_stack "$1"
  local name=$1 id ws wsdir state image config path mask f k chosen=() findings=() run=() agent_env=() secret_names=() secret_values=() have=() argv=("${@:3}")
  open_agent "$name" "$2"
  if [[ -n $tools ]]; then
    # Docker would create a missing bind source as root; the app-server's `up` does that.
    state=$(env_get "$(stack_env "$name")" LETTA_STATE_DIR)
    [[ -d $state/tools ]] || die "$name: no agent tools at $state/tools yet; run: lolloctl up $name"
  fi
  image=$(compose "$name" config --format json | jq -r '.services["app-server"].image // empty') ||
    die "$name: docker compose config failed"
  [[ -n $image ]] || die "$name: the compose config has no app-server image"
  config=$(host_docker image inspect --format '{{json .Config}}' "$image") ||
    die "$name: no image $image; run: lolloctl up $name"
  path=$(jq -r '.Env // [] | map(select(startswith("PATH="))) | .[0] // "" | ltrimstr("PATH=")' <<<"$config")
  [[ -n $path ]] || die "$name: image $image sets no PATH"
  # Or Compose and `stale_services` would take the toolbox, or its scan, for an
  # app-server container.
  mapfile -t mask < <(compose_label_mask "$config")

  run=(run --rm --init -i)
  if [[ -t 0 && -t 1 ]]; then run+=(-t); fi
  run+=("${mask[@]}")
  # The workspaces directory, not the agent's own: a path built from the id, or
  # a link the agent made, then resolves inside the container, never on the host.
  # shellcheck disable=SC2054 # the commas are tmpfs options
  run+=(--hostname "toolbox-$name" --label "lolloctl.toolbox=$name" --label "lolloctl.agent=$id"
    --security-opt no-new-privileges --memory 8g --pids-limit 4096
    --tmpfs /root:mode=700,exec --tmpfs /tmp:exec
    -v "$wsdir:/work" -w "/work/$id" "${agent_env[@]}"
    -e "PATH=/opt/claude-code/bin:$path")
  # The image already points PATH and the package managers at /opt/agent-tools.
  [[ -z $tools ]] || run+=(-v "$state/tools:/opt/agent-tools:$tools")
  toolbox_personal "$(toolbox_file)" use
  for k in $TOOLBOX_KINDS; do
    if toolbox_chosen "$k"; then chosen+=("$k"); fi
  done
  toolbox_builtins
  toolbox_git_config
  toolbox_personal "$(toolbox_file)" all
  case $tools in
    ro) have+=("agent tools (read-only)") ;;
    rw) have+=("agent tools (writable)") ;;
  esac
  for k in "${!secret_names[@]}"; do run+=(-e "${secret_names[k]}"); done

  # Last before starting, so every other refusal comes first.
  toolbox_scan "$name"
  if ((${#findings[@]})); then
    for f in "${findings[@]}"; do warn "toolbox: $(printable "$f")"; done
    [[ -n $trust ]] ||
      die "toolbox: the workspace of $id holds configuration that runs code when git or another tool is used there (above); read it, then run again with --trust-workspace to start anyway"
    warn "toolbox: starting anyway (--trust-workspace); git still runs none of the workspace's hooks, fsmonitor or ssh command"
  fi

  if ((${#have[@]})); then
    info "toolbox: $(printf '%s, ' "${have[@]}" | sed 's/, $//')"
  else
    info "toolbox: nothing of yours found"
  fi
  ((${#chosen[@]})) ||
    info "toolbox: no credentials; add --gh, --ssh or --claude, or a line 'use gh ssh claude' (the ones you want) to $(toolbox_file)"
  if [[ " ${chosen[*]} " == *" claude "* && " ${secret_names[*]} " != *" CLAUDE_CODE_OAUTH_TOKEN "* ]]; then
    warn "no Claude token, so claude will ask you to log in; to set one up once: claude setup-token, then on Linux: secret-tool store --label='Claude toolbox' service claude-toolbox, or on macOS: security add-generic-password -s claude-toolbox -a \"\$USER\" -w"
  fi
  # Secrets reach docker through its environment, so they never show in argv
  # (which `env -i NAME=value` would do); `-e NAME` copies each one.
  (
    for k in "${!secret_names[@]}"; do export "${secret_names[k]}=${secret_values[k]}"; done
    exec docker "${run[@]}" "$image" "${argv[@]:-bash}"
  )
}

# ── runtime audit ────────────────────────────────────────────────────────────
# `audit` reports where a stack's agent runtime departs from what lollo shipped
# or the operator accepted: lollo's installed skills and executor, unknown
# skills, cron files and Settings -> MCP entries, and the app-server
# container's own changes. Agents are root in the app-server, so nothing here
# asks it: the state is read from a container of the backup image (read-only
# mount, no network) and the container's changes from the Docker daemon. It
# only reports, and the commands that call it (status, up, skills, backup) go
# on whatever it finds. Acceptances live in stacks/<name>/audit-accepted,
# outside the state the app-server mounts, each bound to the entry's hash.

# Lollo's own Settings -> MCP entries (lib/mcp-servers.mjs's GROUPS; a test keeps
# the two lists in step): an http entry with one of these URLs, or a stdio
# entry with one of these commands, under any name.
AUDIT_MCP_URLS=(http://lollo-vault:8000/mcp http://lollo-news-radar:8000/mcp http://lollo-browser:8000/mcp)
AUDIT_MCP_COMMANDS=(/opt/lollo-doc-tools/bin/officeagent /opt/lollo-doc-tools/bin/pdf-mcp)
# The names those entries get; another entry under one of them is reported as
# pointing elsewhere.
AUDIT_MCP_NAMES=(office pdf vault news-radar browser)
# Paths in the app-server's container where a change survives as a way back in:
# a trailing / is a directory (what is under it, and the directory itself being
# added or deleted), anything else one file. letta-code is installed globally
# by npm under /usr/local/lib (/usr/local/lib/node_modules/@letta-ai/letta-code,
# the Node base image's prefix; read from the v0.50.2 app-server image), so
# /usr/local/lib covers it; the Lettuce upgrade checklist re-checks that.
AUDIT_SENSITIVE=(/etc/cron.d/ /etc/ld.so.preload /etc/profile.d/ /etc/bash.bashrc /etc/environment
  /usr/bin/ /usr/sbin/ /usr/local/bin/ /usr/local/lib/)
# What lollo itself adds there: the executor's cron file (install_executor).
AUDIT_DIFF_OURS=("/etc/cron.d/$EXECUTOR_JOB")
# Docker's own: in a container run with init (upstream's app-server is), the
# daemon bind-mounts its docker-init here read-only, and `docker diff` lists the
# mount point as added on every container.
AUDIT_DOCKER_INIT=/usr/sbin/docker-init
# Upstream's skill the BFF writes itself, from Settings -> MCP (MCP_SKILL_NAME,
# bff/src/mcp/skill.ts), next to docker/agent-skills: upstream's too.
AUDIT_BFF_SKILLS=(mcp-servers)
# How many of the sensitive changes the report lists before "and N more".
AUDIT_DIFF_SHOWN=50

# Run by bash in a backup container as: bash -s -- ROOT LOLLO_SKILL... with this
# script on stdin and the stack's letta-home read-only at ROOT. Prints records of
# three NUL-terminated fields, never sourced or evaluated by lolloctl:
#   f PATH SHA256   a file (PATH relative to ROOT)    l PATH TARGET  a link
#   o PATH -        neither file, link nor directory  e PATH TYPE    a top-level
#   entry of skills/ or system-cron/ (d, f, l or o)   h PATH TEXT    a cron
#   file's first lines   m settings JSON (or m - -)    more DIR N     N left out
# Lollo's skills come first, uncapped but for 1000 files each; every other
# list is capped, so a flood of entries cannot hide them. Nothing is followed:
# a link is reported as a link, never read through.
# shellcheck disable=SC2016 # expanded by bash in the container
AUDIT_SCAN='set -u
r=$1
shift
lollo=" $* "
rec() { printf "%s\0%s\0%s\0" "$1" "$2" "$3"; }
files() {
  local p n=0 all
  [[ -d $r/$1 && ! -L $r/$1 ]] || return 0
  all=$(find -P "$r/$1" -mindepth 1 ! -type d -printf . | wc -c)
  while IFS= read -r -d "" p; do
    if [[ -L $p ]]; then
      rec l "${p#"$r"/}" "$(readlink -- "$p")"
    elif [[ -f $p ]]; then
      rec f "${p#"$r"/}" "$(sha256sum <"$p" | cut -c1-64)"
    else
      rec o "${p#"$r"/}" -
    fi
    n=$((n + 1))
  done < <(find -P "$r/$1" -mindepth 1 ! -type d -print0 | LC_ALL=C sort -z | head -z -n "$2")
  ((all <= n)) || rec more "$1" "$((all - n))"
}
top() {
  local p n=0 all t
  [[ -d $r/$1 && ! -L $r/$1 ]] || return 0
  all=$(find -P "$r/$1" -mindepth 1 -maxdepth 1 -printf . | wc -c)
  while IFS= read -r -d "" p; do
    if [[ -L $p ]]; then
      t=l
    elif [[ -d $p ]]; then
      t=d
    elif [[ -f $p ]]; then
      t=f
    else
      t=o
    fi
    rec e "${p#"$r"/}" "$t"
    if [[ $t == l ]]; then
      rec l "${p#"$r"/}" "$(readlink -- "$p")"
    elif [[ $t == d && ($1 != skills || $lollo != *" ${p##*/} "*) ]]; then
      files "$1/${p##*/}" 200
    elif [[ $t == f ]]; then
      rec f "${p#"$r"/}" "$(sha256sum <"$p" | cut -c1-64)"
      [[ $1 != system-cron ]] || rec h "${p#"$r"/}" "$(head -c 2000 "$p" | head -n 5)"
    fi
    n=$((n + 1))
  done < <(find -P "$r/$1" -mindepth 1 -maxdepth 1 -print0 | LC_ALL=C sort -z | head -z -n "$2")
  ((all <= n)) || rec more "$1" "$((all - n))"
}
# lollo skills by name first, whatever the cap on the listing below
for s in "$@"; do
  p=$r/skills/$s
  if [[ -L $p ]]; then
    rec e "skills/$s" l
    rec l "skills/$s" "$(readlink -- "$p")"
  elif [[ -d $p ]]; then
    rec e "skills/$s" d
    files "skills/$s" 1000
  elif [[ -f $p ]]; then
    rec e "skills/$s" f
  elif [[ -e $p ]]; then
    rec e "skills/$s" o
  fi
done
files lollo/executor/bin 100
top skills 500
top system-cron 200
m=$r/mcp-home/.letta/settings.json
if [[ -f $m && ! -L $m ]]; then rec m settings "$(head -c 1048576 "$m")"; else rec m - -; fi'

# shipped_skills -> the names of agent-skills/'s skills (a directory with a
# SKILL.md and a valid name), what sync_skills installs and backup leaves out
shipped_skills() {
  local f s
  for f in "$LOLLO_HOME"/agent-skills/*/SKILL.md; do
    [[ -f $f ]] || continue
    s=${f%/SKILL.md}
    s=${s##*/}
    [[ ! $s =~ ^[a-z0-9][a-z0-9-]*$ ]] || printf '%s\n' "$s"
  done
}

# audit_file NAME -> the stack's accepted entries, "<sha256> <kind>:<key>" per line
audit_file() { printf '%s/audit-accepted' "$(stack_dir "$1")"; }

# audit_hash -> the sha256 of stdin
audit_hash() { sha256sum | cut -c1-64; }

# audit_tree_hash PREFIX -> one hash for every scanned file and link at or under
# PREFIX (A_FILE), so an accepted skill is reported again once anything in it changes
audit_tree_hash() {
  local k
  for k in "${!A_FILE[@]}"; do
    if [[ $k == "$1" || $k == "$1"/* ]]; then printf '%s\t%s\0' "$k" "${A_FILE[$k]}"; fi
  done | LC_ALL=C sort -z | audit_hash
}

# audit_content CID KIND PATH -> the hash an accepted container change is held
# to: for an added or changed file or link, of its kind, path and the daemon's
# copy of it (`docker cp`, never exec: bytes, mode, owner, size, link target,
# but not its time, since the entrypoint copies the cron files again on every
# start), so an accepted file written anew is reported again; for a directory or a
# deleted path, of kind and path alone (a directory's entries are changes of
# their own). A path the copy cannot read hashes as unreadable, never as an
# accepted file.
audit_content() {
  local kind=$2 path=$3 first="" sum=unreadable tmp
  if [[ $kind != D ]]; then
    # The first entry of the copy says what PATH is (tar -tv starts with its mode).
    first=$(host_docker cp "$1:$path" - 2>/dev/null | head -c 65536 | tar -tvf - 2>/dev/null | head -n 1) || :
    case $first in
      d*) sum="" ;;
      -* | l* | h*)
        tmp=$(mktemp) || die "audit: could not make a temporary file"
        if host_docker cp "$1:$path" - >"$tmp" 2>/dev/null; then
          sum=$({
            tar -tvf "$tmp" | awk 'NR == 1 { $4 = ""; $5 = ""; print }'
            tar -xOf "$tmp" | sha256sum
          } | sha256sum | cut -c1-64) || sum=unreadable
        fi
        rm -f "$tmp"
        ;;
    esac
  else
    sum=""
  fi
  printf '%s %s %s' "$kind" "$path" "$sum" | audit_hash
}

# audit_find KIND:KEY HASH TEXT... -> one finding the operator may accept: kept
# out of the report when the accepted list has it with this hash. TEXT is
# already printable.
audit_find() {
  A_CUR[$1]=$2
  if [[ -n ${A_ACC[$1]:-} ]]; then
    if [[ ${A_ACC[$1]} == "$2" ]]; then return 0; fi
    A_FINDINGS+=("${*:3} (changed since it was accepted; accept again: lolloctl audit $A_NAME --accept $(printable "$1"))")
    return 0
  fi
  # The hint goes on the finding's first line; any quoted text follows it.
  local text="${*:3}" first
  first=${text%%$'\n'*}
  A_FINDINGS+=("$first (accept: lolloctl audit $A_NAME --accept $(printable "$1"))${text#"$first"}")
}

# audit_collect NAME VERBOSE -> fills A_FINDINGS (to report), A_NOTES (to show)
# and A_CUR (the acceptable entries' current hashes); 0 when it audited, 2 (with
# A_ERROR) when it could not. Explicit returns throughout: callers run it where
# errexit is off.
audit_collect() {
  local name=$1 verbose=${2:-} f state h out k a b s rel want got n cid line kind path shown=0 more=0 cron mcp init
  local -a lollo=() upstream=()
  local -A wanted=()
  A_NAME=$name A_ERROR="" A_CID="" A_FINDINGS=() A_NOTES=()
  declare -gA A_FILE=() A_TOP=() A_HEAD=() A_CUR=() A_ACC=()
  f=$(stack_env "$name")
  state=$(env_get "$f" LETTA_STATE_DIR)
  h=$state/letta-home
  if [[ ! -d $state ]]; then
    A_ERROR="no state directory at $state"
    return 2
  fi
  # Not started yet: nothing an agent could have changed. (`run -v` would also
  # create the directory, as root.)
  if [[ ! -d $h ]]; then
    A_NOTES+=("nothing to audit yet: $name has not been started")
    return 0
  fi
  if [[ -f $(audit_file "$name") ]]; then
    while read -r a b; do
      if [[ $a =~ ^[0-9a-f]{64}$ && -n $b ]]; then A_ACC[$b]=$a; fi
    done <"$(audit_file "$name")"
  fi
  mapfile -t lollo < <(shipped_skills)
  upstream=("${AUDIT_BFF_SKILLS[@]}")
  for s in "$(upstream_dir)"/docker/agent-skills/*/; do
    if [[ -d $s ]]; then
      s=${s%/}
      upstream+=("${s##*/}")
    fi
  done
  if ! ensure_backup_image; then
    A_ERROR="no image $BACKUP_IMAGE (backup/Dockerfile)"
    return 2
  fi
  out=$(mktemp) || return 2
  if ! host_docker "${BACKUP_RUN[@]}" -i --label "lolloctl.audit=$name" -v "$h:/src:ro" "$BACKUP_IMAGE" \
    bash -s -- /src "${lollo[@]}" <<<"$AUDIT_SCAN" >"$out"; then
    rm -f "$out"
    A_ERROR="the scan of $h failed"
    return 2
  fi
  while IFS= read -r -d '' k && IFS= read -r -d '' a && IFS= read -r -d '' b; do
    case $k in
      f) A_FILE[$a]=$b ;;
      l) A_FILE[$a]="link -> $b" ;;
      o) A_FILE[$a]="not a file" ;;
      e) A_TOP[$a]=$b ;;
      h) A_HEAD[$a]=$b ;;
      m) [[ $a != settings ]] || mcp=$b ;;
      more) A_NOTES+=("$(printable "$a"): $b more entries not scanned") ;;
      *)
        A_ERROR="unexpected output from the scan"
        break
        ;;
    esac
  done <"$out"
  rm -f "$out"
  [[ -z $A_ERROR ]] || return 2

  # Lollo's skills, file by file. None at all, and no manifest: never installed.
  n=0
  for s in "${lollo[@]}"; do [[ -z ${A_TOP[skills/$s]:-} ]] || n=$((n + 1)); done
  if ((n == 0)) && [[ -z ${A_TOP[skills/.lolloctl-skills]:-} ]]; then
    ((${#lollo[@]} == 0)) || A_NOTES+=("lollo's skills are not installed yet (lolloctl skills $name installs them)")
  else
    for s in "${lollo[@]}"; do
      if [[ -z ${A_TOP[skills/$s]:-} ]]; then
        A_FINDINGS+=("lollo skill $s is missing (lolloctl skills $name puts it back)")
        continue
      fi
      if [[ ${A_TOP[skills/$s]} != d ]]; then
        A_FINDINGS+=("lollo skill $s is not a directory (lolloctl skills $name puts it back)")
        continue
      fi
      wanted=()
      while IFS= read -r -d '' rel; do
        wanted[skills/$s/${rel#./}]=$(audit_hash <"$LOLLO_HOME/agent-skills/$s/$rel")
      done < <(cd "$LOLLO_HOME/agent-skills/$s" && find . -type f -print0)
      for k in "${!wanted[@]}"; do
        if [[ -z ${A_FILE[$k]:-} ]]; then
          A_FINDINGS+=("lollo skill file ${k#skills/} is missing (lolloctl skills $name puts it back)")
        elif [[ ${A_FILE[$k]} != "${wanted[$k]}" ]]; then
          A_FINDINGS+=("lollo skill file ${k#skills/} was changed (lolloctl skills $name puts it back)")
        fi
      done
      for k in "${!A_FILE[@]}"; do
        if [[ $k == skills/$s/* && -z ${wanted[$k]:-} ]]; then
          A_FINDINGS+=("lollo skill file $(printable "${k#skills/}") was added (lolloctl skills $name removes it)")
        fi
      done
    done
    # A hint only: the install replaces lollo's skills whatever it says.
    want=$(printf '%s\n' "${lollo[@]}" | audit_hash)
    [[ ${A_FILE[skills/.lolloctl-skills]:-} == "$want" ]] ||
      A_FINDINGS+=("the skills manifest .lolloctl-skills does not list exactly lollo's skills (lolloctl skills $name rewrites it)")
  fi

  # Every other skill: upstream's are the BFF's, the rest need an acceptance.
  for k in "${!A_TOP[@]}"; do
    [[ $k == skills/* ]] || continue
    s=${k#skills/}
    [[ " ${lollo[*]} ${upstream[*]} " != *" $s "* && $s != .lolloctl-skills && $s != .lolloctl.* ]] || continue
    audit_find "skill:$s" "$(audit_tree_hash "$k")" "unknown skill $(printable "$s")"
  done

  # The executor: lollo's, never accepted; up reinstalls it.
  if executor_wanted "$(env_get "$f" COMPOSE_PROFILES)"; then
    want=$(audit_hash <"$LOLLO_HOME/landing/executor/run.mjs")
    got=${A_FILE[lollo/executor/bin/run.mjs]:-}
    if [[ -z $got ]]; then
      A_NOTES+=("the lollo executor is not installed yet (lolloctl up $name installs it)")
    elif [[ $got != "$want" ]]; then
      A_FINDINGS+=("the lollo executor's run.mjs was changed (lolloctl up $name puts it back)")
    fi
    for k in "${!A_FILE[@]}"; do
      if [[ $k == lollo/executor/bin/* && $k != lollo/executor/bin/run.mjs ]]; then
        A_FINDINGS+=("the lollo executor has an added file $(printable "${k#lollo/executor/bin/}") (lolloctl up $name removes it)")
      fi
    done
    cron=system-cron/$EXECUTOR_JOB
    if [[ -n ${A_TOP[$cron]:-} && ${A_FILE[$cron]:-} != "$(printf '%s\n' "$(executor_cron "$name")" | audit_hash)" ]]; then
      A_FINDINGS+=("the lollo executor's cron file $EXECUTOR_JOB was changed (lolloctl up $name puts it back)")
    fi
  else
    got=${A_TOP[system-cron/$EXECUTOR_JOB]:-}
    for k in "${!A_FILE[@]}"; do
      if [[ $k == lollo/executor/bin/* ]]; then got=1; fi
    done
    [[ -z $got ]] || A_NOTES+=("the lollo executor is installed although no profile needs it (lolloctl up $name removes it)")
  fi

  # Cron files other than the executor's: upstream's entrypoint copies them to
  # /etc/cron.d at every start.
  for k in "${!A_TOP[@]}"; do
    [[ $k == system-cron/* && $k != "system-cron/$EXECUTOR_JOB" ]] || continue
    s=${k#system-cron/}
    a=$(audit_tree_hash "$k")
    line="cron file $(printable "$s")"
    if [[ -n ${A_HEAD[$k]:-} ]]; then
      line+=$'\n'$(printable_text <<<"${A_HEAD[$k]}" | sed 's/^/      | /')
    fi
    audit_find "cron:$s" "$a" "$line"
  done

  # Settings -> MCP: lollo's entries are left out, every other one grouped by name.
  if [[ -z ${mcp+x} ]]; then
    A_NOTES+=("no Settings -> MCP list yet (the BFF writes it on its first start)")
  else
    out=$(jq -c --argjson urls "$(printf '%s\n' "${AUDIT_MCP_URLS[@]}" | jq -R . | jq -sc .)" \
      --argjson cmds "$(printf '%s\n' "${AUDIT_MCP_COMMANDS[@]}" | jq -R . | jq -sc .)" '
      [(.agents // empty)[] | select(type == "object" and .agentId == "agent-local-mcp-global")] as $g
      | if ($g | length) != 1 or ($g[0].mcpServers | type) != "array"
          or ($g[0].mcpServers | all(type == "object") | not) then error("shape") else $g[0].mcpServers end
      | map(select(((.transport == "http" and (.url as $u | $urls | any(. == $u)) and (has("headers") | not))
          or (.transport == "stdio" and (.command as $c | $cmds | any(. == $c)) and (has("args") | not) and (has("env") | not))) | not))
      | group_by(.name | tostring)[] | {name: (.[0].name | tostring), entries: .}' <<<"$mcp" 2>/dev/null) || {
      A_FINDINGS+=("the Settings -> MCP list could not be read, or is not in the shape lollo expects")
      out=""
    }
    while IFS= read -r line; do
      [[ -n $line ]] || continue
      s=$(jq -r .name <<<"$line")
      a=$(jq -cS .entries <<<"$line" | audit_hash)
      if [[ " ${AUDIT_MCP_NAMES[*]} " == *" $s "* ]]; then
        audit_find "mcp:$s" "$a" "MCP server $(printable "$s") has lollo's name but is not lollo's: $(printable "$(jq -c .entries <<<"$line")")"
      else
        audit_find "mcp:$s" "$a" "MCP server $(printable "$s"): $(printable "$(jq -c .entries <<<"$line")")"
      fi
    done <<<"$out"
  fi

  # The container's own layer, from the Docker daemon. Never through exec.
  cid=$(compose "$name" ps -aq app-server 2>/dev/null | head -n 1) || cid=""
  if [[ -z $cid ]]; then
    A_NOTES+=("container: skipped, $name has no app-server container")
  elif ! out=$(host_docker diff "$cid"); then
    A_NOTES+=("container: could not read the app-server container's changes (docker diff)")
  else
    A_CID=$cid
    init=$(host_docker inspect --format '{{.HostConfig.Init}}' "$cid" 2>/dev/null) || init=""
    n=0
    while read -r kind path; do
      [[ -n $path ]] || continue
      n=$((n + 1))
      [[ -z $verbose ]] || A_NOTES+=("container: $kind $(printable "$path")")
      [[ " ${AUDIT_DIFF_OURS[*]} " != *" $path "* ]] || continue
      [[ $init != true || $kind != A || $path != "$AUDIT_DOCKER_INIT" ]] || continue
      want=""
      for a in "${AUDIT_SENSITIVE[@]}"; do
        if [[ $a == */ ]]; then
          if [[ $path == "$a"* || ($path == "${a%/}" && $kind != C) ]]; then want=1; fi
        elif [[ $path == "$a" ]]; then
          want=1
        fi
      done
      [[ -n $want ]] || continue
      # Read through the daemon only when accepted; any other is reported anyway,
      # and `--accept` reads it then (a placeholder of ?KIND till then).
      if [[ -n ${A_ACC[diff:$path]:-} ]]; then
        a=$(audit_content "$cid" "$kind" "$path")
      else
        a="?$kind"
      fi
      if [[ -n ${A_ACC[diff:$path]:-} && ${A_ACC[diff:$path]} == "$a" ]]; then
        A_CUR[diff:$path]=$a
        continue
      fi
      if ((shown >= AUDIT_DIFF_SHOWN)); then
        more=$((more + 1))
        A_CUR[diff:$path]=$a
        continue
      fi
      shown=$((shown + 1))
      audit_find "diff:$path" "$a" "container: $kind $(printable "$path")"
    done <<<"$out"
    ((more == 0)) || A_FINDINGS+=("container: $more more sensitive change(s) (lolloctl audit $name --verbose lists every change)")
    A_NOTES+=("container: $n change(s) in all since its image")
  fi
  return 0
}

# audit_report NAME MODE -> runs the audit and prints the report (MODE full or
# verbose, on stdout) or one line (summary); 0 clean, 1 findings, 2 could not
audit_report() {
  local name=$1 mode=$2 x
  audit_collect "$name" "$([[ $mode != verbose ]] || echo 1)" || {
    if [[ $mode == summary ]]; then
      warn "$name: the runtime audit could not run: $(printable "$A_ERROR"); run: lolloctl audit $name"
    else
      warn "$name: could not audit: $(printable "$A_ERROR")"
    fi
    return 2
  }
  if [[ $mode == summary ]]; then
    if ((${#A_FINDINGS[@]})); then
      info "$name: runtime audit: ${#A_FINDINGS[@]} finding(s); run: lolloctl audit $name"
      return 1
    fi
    info "$name: runtime audit: nothing to report"
    return 0
  fi
  printf '== %s: runtime audit\n' "$name"
  for x in "${A_FINDINGS[@]}"; do printf '  %s\n' "$x"; done
  for x in "${A_NOTES[@]}"; do printf '  note: %s\n' "$x"; done
  if ((${#A_FINDINGS[@]})); then
    printf '%s: %s finding(s)\n' "$name" "${#A_FINDINGS[@]}"
    return 1
  fi
  printf '%s: nothing to report\n' "$name"
  return 0
}

# audit_summary NAME -> one line for status, up, skills and backup; never fails
# and never stops them, whatever the audit finds or fails on
audit_summary() {
  local e=$-
  set +e
  (
    set -e
    audit_report "$1" summary
  )
  [[ $e != *e* ]] || set -e
  return 0
}

# audit_accept NAME accept|unaccept KIND:KEY -> records (or forgets) one
# reported entry with its current hash, atomically, mode 600
audit_accept() {
  local name=$1 op=$2 key=$3 file tmp a b
  [[ $key =~ ^(skill|cron|mcp|diff): && -n ${key#*:} && $key != *[[:cntrl:]]* ]] ||
    die "expected skill:<name>, cron:<file>, mcp:<server> or diff:<path>, without control characters: $(printable "$key")"
  case $key in
    skill:*)
      [[ " $(shipped_skills | paste -sd' ') " != *" ${key#skill:} "* ]] ||
        die "$name: ${key#skill:} is lollo's own skill; it is never accepted, and lolloctl skills $name puts it back"
      ;;
    "cron:$EXECUTOR_JOB" | "diff:/etc/cron.d/$EXECUTOR_JOB")
      die "$name: $EXECUTOR_JOB is the lollo executor's; it is never accepted, and lolloctl up $name puts it back"
      ;;
  esac
  file=$(audit_file "$name")
  if [[ $op == accept ]]; then
    audit_collect "$name" || die "$name: could not audit: $(printable "$A_ERROR")"
    [[ -n ${A_CUR[$key]:-} ]] || die "$name: the audit reports nothing named $(printable "$key") (see: lolloctl audit $name)"
    if [[ $key == diff:* && ${A_CUR[$key]} == \?* ]]; then
      A_CUR[$key]=$(audit_content "$A_CID" "${A_CUR[$key]#\?}" "${key#diff:}")
    fi
  fi
  tmp=$(mktemp "$file.XXXXXX")
  if [[ -f $file ]]; then
    while read -r a b; do
      [[ $b == "$key" ]] || printf '%s %s\n' "$a" "$b"
    done <"$file" >"$tmp"
  fi
  [[ $op != accept ]] || printf '%s %s\n' "${A_CUR[$key]}" "$key" >>"$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$file"
  if [[ $op == accept ]]; then
    info "$name: accepted $(printable "$key") as it is now; a change to it is reported again"
  else
    info "$name: $(printable "$key") is no longer accepted"
  fi
}

cmd_audit() {
  local usage="usage: lolloctl audit <name|all> [--verbose] | lolloctl audit <name> --accept|--unaccept <kind:key>"
  local mode=full n rc=0 r targets
  case ${2:-} in
    --accept | --unaccept)
      (($# == 3)) || die "$usage"
      validate_name "$1"
      require_stack "$1"
      audit_accept "$1" "${2#--}" "$3"
      return
      ;;
    --verbose) mode=verbose ;;
    "") ;;
    *) die "$usage" ;;
  esac
  (($# == 1 || $# == 2)) || die "$usage"
  targets=$(expand_targets "$1")
  for n in $targets; do
    set +e
    (
      set -e
      audit_report "$n" "$mode"
    )
    r=$?
    set -e
    ((r <= rc)) || rc=$r
  done
  return "$rc"
}

# ── backup ───────────────────────────────────────────────────────────────────
# `backup` copies what the images cannot recreate (agents, memory, conversations,
# workspaces, agent-installed tools, Settings skills, the vault and stack.env) to
# <dir>/<name>/: a dated rsync snapshot that hard-links files unchanged since the
# previous one, or with --compress a tar.gz. The state is root-owned, so it is
# read in a throwaway container of backup/Dockerfile. The helpers below read
# cmd_backup's settings (dest, compress, tools, when, keep).

# Set by main (image_name backup): RELEASE's name in release mode, else the clone's build.
BACKUP_IMAGE=
# No network, and only the capabilities copying needs: read everything, write
# into the operator's directory and hand the copies to the operator (--chown).
# --init: as PID 1, sh would ignore the signal docker forwards on Ctrl-C.
BACKUP_RUN=(run --rm --init --network none --read-only --tmpfs /tmp --security-opt no-new-privileges
  --cap-drop ALL --cap-add CHOWN --cap-add DAC_OVERRIDE --cap-add FOWNER)
# build_backup_image -> (re)builds the image backup copies with, from a clone
# (cached layers make an unchanged rebuild cheap); in release mode pulls the
# published one unless it is on the host
build_backup_image() {
  if release_mode; then
    host_docker image inspect "$BACKUP_IMAGE" >/dev/null 2>&1 || host_docker pull -q "$BACKUP_IMAGE" >/dev/null
  else
    host_docker build -q -t "$BACKUP_IMAGE" "$LOLLO_HOME/backup" >/dev/null
  fi
}

# ensure_backup_image -> the backup image exists (it also fills the tools'
# volume: ensure_doc_tools_volume)
ensure_backup_image() {
  host_docker image inspect "$BACKUP_IMAGE" >/dev/null 2>&1 && return 0
  build_backup_image
}

# A backup's name: its UTC start time, which sorts by age.
BACKUP_TS='[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]T[0-9][0-9][0-9][0-9][0-9][0-9]Z'

# Run by sh in the backup container as: sh -c "$BACKUP_COPY" sh MODE SRC DST OWNER
# PREV OUT EXCLUDE... MODE rsync copies SRC to DST/OUT owned by OWNER, hard-linking
# files unchanged since DST/PREV; MODE tar writes a tar.gz of SRC to stdout, with
# the real owners a restore needs. EXCLUDEs are relative to SRC; backup_stack
# chooses them on the host, never from the state agents write.
# shellcheck disable=SC2016 # expanded by sh in the container
BACKUP_COPY='set -e
mode=$1 src=$2 dst=$3 owner=$4 prev=$5 out=$6
shift 6
x=$(mktemp)
for p in "$@"; do printf "%s\n" "$p"; done >"$x"
rc=0
if [ "$mode" = tar ]; then
  sed "s|^|./|" "$x" >"$x.tar"
  tar -C "$src" --numeric-owner --anchored -X "$x.tar" -czf - . || rc=$?
  # 1: a file changed while it was read, as in a live copy; the archive is complete.
  if [ "$rc" = 1 ]; then echo "warning: files changed during the copy" >&2; rc=0; fi
else
  sed "s|^|/|" "$x" >"$x.rsync"
  rsync -aH --numeric-ids --chown="$owner" --exclude-from="$x.rsync" \
    ${prev:+--link-dest="$dst/$prev"} "$src/" "$dst/$out/" || rc=$?
  # 24: files vanished while copying, as in a live copy.
  if [ "$rc" = 24 ]; then echo "warning: files vanished during the copy" >&2; rc=0; fi
fi
exit "$rc"'

# backup_list DIR SUFFIX -> DIR's snapshots (SUFFIX "") or archives (SUFFIX
# .tar.gz), oldest first
backup_list() {
  local p
  # shellcheck disable=SC2086 # BACKUP_TS is a glob
  for p in "$1"/$BACKUP_TS"$2"; do
    if [[ -e $p ]]; then printf '%s\n' "${p##*/}"; fi
  done
}

# backup_rm NAME DIR ENTRY... -> deletes DIR's entries from the container: a
# snapshot can hold read-only directories (Go's module cache) the operator cannot empty
backup_rm() {
  local name=$1 dir=$2 e paths=()
  shift 2
  (($#)) || return 0
  for e in "$@"; do paths+=("/dst/$e"); done
  host_docker "${BACKUP_RUN[@]}" --label "lolloctl.backup=$name" -v "$dir:/dst" "$BACKUP_IMAGE" \
    rm -rf -- "${paths[@]}" || die "$name: could not delete $* in $dir"
}

# backup_choice NAME -> pause|live for a running stack: --pause or --live, else the
# operator's answer
backup_choice() {
  local answer=""
  if [[ -n $when ]]; then
    printf '%s' "$when"
    return
  fi
  info "$1 is running. A live copy can catch memory repos, conversations or the vault mid-write and"
  info "leave a corrupt backup; pausing is recommended (agents and the UI freeze until the copy ends)."
  info "  [p] pause $1 while copying   [l] copy live anyway (not recommended)   [a] abort"
  printf 'Choice [p/l/a]: ' >&2
  read -r answer || true
  case $answer in
    p | P) printf pause ;;
    l | L) printf live ;;
    *) die "aborted (to answer ahead of time, as from cron: --pause or --live)" ;;
  esac
}

# backup_prune NAME DIR -> keeps DIR's newest $keep backups of the kind just made
backup_prune() {
  local name=$1 dir=$2 p old=()
  if [[ -n $compress ]]; then
    mapfile -t old < <(backup_list "$dir" .tar.gz | head -n -"$keep")
    for p in "${old[@]}"; do rm -f -- "${dir:?}/$p"; done
  else
    mapfile -t old < <(backup_list "$dir" "" | head -n -"$keep")
    backup_rm "$name" "$dir" "${old[@]}"
  fi
  ((${#old[@]} == 0)) || info "$name: removed ${#old[@]} older backup(s): ${old[*]}"
}

# The stack's volumes a backup holds, each in the entry of the same name, and
# restore puts back: "<entry> <volume> <owner> <mode> <only>". restore gives the
# volume that owner and mode (a volume Docker fills from an image takes the
# image's owner; one restore creates would be root's). <only> google: only with
# --with-google, as Lettuce's Google client and tokens are; a refresh token
# opens the person's mail and Drive, and reconnecting costs them a minute.
# Not browser-data, on purpose: it holds the browser's kept sign-ins (live
# session cookies for the sites people chose), which a backup would copy to
# wherever backups go, readable by whoever holds them. People sign in again and
# set the browser up again after a restore (docs/browser.md).
BACKUP_VOLUMES=(
  "vault vault-data 10001:10001 700 always"
  "pipelock pipelock-data 65532:65532 700 always"
  "news-radar news-radar-data 10002:10002 700 always"
  "notifications notifications-data 10005:10005 700 always"
  "google-policy google-policy 0:0 755 google"
  "google-creds google-creds 0:0 755 google"
)

# The platform file backup_stack writes, removed when its subshell exits.
BACKUP_PLATFORM_FILE=

# backup_stack NAME -> one backup of the stack into $dest/NAME. Run in a subshell:
# the lock it takes is released, and its platform file removed, when that exits.
backup_stack() {
  local name=$1 f state dir ts prev s p e v only lock choice="" mounts=() excludes=() stale=()
  f=$(stack_env "$name")
  state=$(env_get "$f" LETTA_STATE_DIR)
  [[ -d $state ]] || die "$name: no state directory at $state"
  dir=$dest/$name
  (umask 077 && mkdir -p "$dir")
  # A second run would take this one's .partial-* for a leftover and delete it.
  exec {lock}>"$dir/.lock"
  flock -n "$lock" || die "$name: another backup of $name is running"
  # config.env holds no secrets, and on a new host restore puts it back for init.
  mounts=(--label "lolloctl.backup=$name" -v "$state:/src/state:ro" -v "$f:/src/stack.env:ro"
    -v "$(config_file):/src/config.env:ro")
  # Turning a profile off keeps its volume, so look for each either way; `run -v`
  # would create a missing one.
  for e in "${BACKUP_VOLUMES[@]}"; do
    read -r e v _ _ only <<<"$e"
    [[ $only != google || -n $google ]] || continue
    if has_volume "$name" "$v"; then
      mounts+=(-v "$(stack_volume "$name" "$v"):/src/$e:ro")
    elif [[ $e == vault ]] && has_profile "$(env_get "$f" COMPOSE_PROFILES)" lollo-vault; then
      warn "$name: the vault volume $(vault_volume "$name") does not exist yet; backing up without it"
    fi
  done
  # state/task-logs is the app-server's TMPDIR (Lettuce v0.50.2): background commands' output, which
  # holds vault-wait's answers, and the agents' temporary files; Lettuce keeps it 14 days for its Runs pane.
  excludes=(state/letta-home/mod-cache state/letta-home/claude/paste-cache state/letta-home/claude/backups state/task-logs)
  # The BFF rewrites upstream's skills on every connect.
  for s in "$(upstream_dir)"/docker/agent-skills/*/; do
    if [[ -d $s ]]; then
      s=${s%/}
      excludes+=("state/letta-home/skills/${s##*/}")
    fi
  done
  # What `skills` and `up` reinstall (lollo's skills, their manifest, the
  # executor and its cron file), chosen from the code here, never from the
  # agent-writable manifest: a restore cannot bring back a tampered copy.
  while read -r s; do
    excludes+=("state/letta-home/skills/$s")
  done < <(shipped_skills)
  excludes+=(state/letta-home/skills/.lolloctl-skills "state/letta-home/${EXECUTOR_DIR#/root/.letta/}"
    "state/letta-home/system-cron/$EXECUTOR_JOB")
  [[ -n $tools ]] || excludes+=(state/tools)

  # What an interrupted run left behind.
  for p in "$dir"/.partial-*; do
    if [[ -e $p ]]; then stale+=("${p##*/}"); fi
  done
  backup_rm "$name" "$dir" "${stale[@]}"
  ts=$(date -u +%Y%m%dT%H%M%SZ)
  [[ ! -e $dir/$ts && ! -e $dir/$ts.tar.gz ]] || die "$name: $dir/$ts already exists; run again in a second"
  # The host's platform, as `platform`: agent tools are native programs, and
  # restore leaves them out on a host of another architecture. Removed when the
  # subshell this runs in exits; named .partial-*, so one a kill left goes with
  # the rest on the next run.
  BACKUP_PLATFORM_FILE=$dir/.partial-$ts.platform
  trap 'rm -f -- "$BACKUP_PLATFORM_FILE"' EXIT
  (umask 077 && host_platform >"$BACKUP_PLATFORM_FILE") || die "$name: could not ask Docker for this host's platform"
  mounts+=(-v "$BACKUP_PLATFORM_FILE:/src/platform:ro")
  # Before the copy (and any pause), so what it holds has been looked at.
  audit_summary "$name"
  if stack_running "$name"; then
    choice=$(backup_choice "$name")
  fi
  (
    if [[ $choice == pause ]]; then
      info "$name: paused while copying"
      # Set first: a pause that fails partway leaves some containers paused.
      trap 'compose "$name" unpause >/dev/null || warn "$name: could not unpause it; run: lolloctl compose $name unpause"' EXIT
      trap 'exit 130' INT TERM
      compose "$name" pause >/dev/null || die "$name: could not pause the stack"
    fi
    if [[ -n $compress ]]; then
      if ! (umask 077 && host_docker "${BACKUP_RUN[@]}" "${mounts[@]}" "$BACKUP_IMAGE" \
        sh -c "$BACKUP_COPY" sh tar /src "" "" "" "" "${excludes[@]}" >"$dir/.partial-$ts.tar.gz"); then
        rm -f "$dir/.partial-$ts.tar.gz"
        die "$name: the copy failed"
      fi
      mv "$dir/.partial-$ts.tar.gz" "$dir/$ts.tar.gz"
    else
      prev=$(backup_list "$dir" "" | tail -n 1)
      host_docker "${BACKUP_RUN[@]}" "${mounts[@]}" -v "$dir:/dst" "$BACKUP_IMAGE" \
        sh -c "$BACKUP_COPY" sh rsync /src /dst "$(id -u):$(id -g)" "$prev" ".partial-$ts" "${excludes[@]}" ||
        die "$name: the copy failed; the next run removes $dir/.partial-$ts"
      mv "$dir/.partial-$ts" "$dir/$ts"
    fi
  )
  info "$name: $dir/$ts${compress:+.tar.gz}"
  [[ -z $keep ]] || backup_prune "$name" "$dir"
}

cmd_backup() {
  local usage="usage: lolloctl backup <name|all> <dir> [--compress] [--no-tools] [--with-google] [--pause|--live] [--keep N]"
  local dest compress="" tools=1 google="" when="" keep="" n rc targets args=() failed=()
  while (($#)); do
    case $1 in
      --compress) compress=1 ;;
      --with-google) google=1 ;;
      --no-tools) tools="" ;;
      --pause | --live)
        [[ -z $when || $when == "${1#--}" ]] || die "use --pause or --live, not both"
        when=${1#--}
        ;;
      --keep)
        [[ ${2:-} =~ ^[1-9][0-9]*$ ]] || die "--keep needs how many backups to keep, 1 or more"
        keep=$2
        shift
        ;;
      -*) die "$usage" ;;
      *) args+=("$1") ;;
    esac
    shift
  done
  ((${#args[@]} == 2)) || die "$usage"
  require_initialised
  targets=$(expand_targets "${args[0]}")
  dest=${args[1]}
  [[ $dest != *[:,]* ]] || die "the destination cannot contain ':' or ','; backup writes to a local directory"
  [[ -d $dest ]] || die "$dest is not a directory"
  dest=$(realpath "$dest")
  [[ $dest != *[:,]* ]] || die "the destination cannot contain ':' or ',': $dest"
  # A clone is public, and a backup holds stack.env and the agents' logins; in
  # the data directory, a backup would back up the earlier ones.
  ! inside "$dest" "$LOLLO_HOME" || die "the destination cannot be inside $LOLLO_HOME"
  ! inside "$dest" "$LOLLO_DATA" || die "the destination cannot be inside $LOLLO_DATA"
  require_mounted "$dest"
  command -v flock >/dev/null || die "flock is required but not installed (util-linux)"
  build_backup_image || die "could not build $BACKUP_IMAGE (backup/Dockerfile)"
  # One stack failing must not cost the others their backup, but Ctrl-C stops
  # them all (the trap runs once the stack's subshell is done). errexit is off
  # inside a subshell that is part of `||` or `if`, so the status is read after.
  trap 'exit 130' INT TERM
  for n in $targets; do
    set +e
    (
      set -e
      backup_stack "$n"
    )
    rc=$?
    set -e
    ((rc == 0)) || failed+=("$n")
  done
  if ((${#failed[@]})); then
    [[ ${args[0]} != all ]] || die "backup failed for: ${failed[*]}"
    exit 1
  fi
}

# ── receipts ─────────────────────────────────────────────────────────────────
# Set by main (image_name pipelock), like BACKUP_IMAGE.
PIPELOCK_IMAGE=
PIPELOCK_KEY_PUB=/data/keys/receipt-signing.json.pub
PIPELOCK_RUN=()

# pipelock_setup NAME -> sets PIPELOCK_RUN to the `docker run` options of
# pipelock_run: no network, no capabilities, the volume read-only, and the
# image's Compose labels emptied (compose_label_mask), so Compose and
# stale_services don't take its containers for the stack's pipelock
pipelock_setup() {
  local name=$1 config mask
  config=$(host_docker image inspect "$PIPELOCK_IMAGE" --format '{{json .Config}}') ||
    die "$name: no $PIPELOCK_IMAGE image; run lolloctl up $name with the lollo-pipelock profile"
  mapfile -t mask < <(compose_label_mask "$config")
  PIPELOCK_RUN=(--rm --network none --read-only --cap-drop ALL --security-opt no-new-privileges
    "${mask[@]}" --label "lolloctl.receipts=$name" -v "$(receipts_volume "$name"):/data:ro")
}

# pipelock_run ENTRYPOINT ARGS... -> a one-off container of the pipelock image
# (after pipelock_setup)
pipelock_run() {
  local entry=$1
  shift
  host_docker run "${PIPELOCK_RUN[@]}" --entrypoint "$entry" "$PIPELOCK_IMAGE" "$@"
}

# receipts_verify NAME -> verifies every receipt and prints pipelock's report.
# A run pipelock has not sealed yet (it is running, or was killed) has no
# proven end, so --allow-prefix accepts a valid prefix; the report still
# labels it VALID PREFIX, END UNPROVEN.
# pipelock refuses a file that changes while it reads it, which a running
# pipelock does with every request, so a failure is retried twice.
receipts_verify() {
  local name=$1 out i
  for i in 1 2 3; do
    ((i == 1)) || sleep 1
    if out=$(pipelock_run pipelock verify-receipt --whole-recorder --chain /data/evidence --key "$PIPELOCK_KEY_PUB" --allow-prefix 2>&1); then
      printf '%s\n' "$out"
      return 0
    fi
  done
  printf '%s\n' "$out" >&2
  if compose "$name" ps --status running --services | grep -qx lollo-pipelock; then
    die "$name: the receipts do not verify, but pipelock is running and may have written to them during each check; retry when the stack is quiet, or after: lolloctl down $name"
  fi
  die "$name: the receipts do not verify"
}

# receipt_sessions NAME -> "<epoch> <session>" per pipelock run, newest first.
# Each start of the proxy is a session, written as evidence-<session>-<n>.jsonl.
receipt_sessions() {
  # shellcheck disable=SC2016 # expanded by sh in the container
  pipelock_run sh -c 'for f in /data/evidence/evidence-*.jsonl; do [ -e "$f" ] && stat -c "%Y %n" "$f"; done; true' |
    sed -E 's#^([0-9]+) /data/evidence/evidence-(.*)-[0-9]+\.jsonl$#\1 \2#' |
    sort -rn | awk '!seen[$2]++'
}

# ── restore ──────────────────────────────────────────────────────────────────
# Run by sh in the backup container as: sh -c "$RESTORE_COPY" sh MODE SRC DST
# KEEP_TOOLS, then ENTRY OWNER ROOT_OWNER ROOT_MODE for each of the backup's
# entries to put back (BACKUP_VOLUMES, and state). DST/ENTRY is made to match
# the backup's ENTRY: MODE rsync copies the directory SRC/ENTRY (a snapshot
# keeps no owners, so OWNER gets them all); MODE tar extracts every ENTRY from
# the archive SRC, with their owners, in one pass. With KEEP_TOOLS (a backup
# taken with --no-tools, or from another architecture), DST/state/tools stays as
# it is, and the backup's tools stay out. DST/ENTRY itself ends
# up ROOT_OWNER's, mode ROOT_MODE. Entry names have no spaces.
# shellcheck disable=SC2016 # expanded by sh in the container
RESTORE_COPY='set -e
mode=$1 src=$2 dst=$3 keep_tools=$4
shift 4
# prepare ENTRY OWNER ROOT_OWNER ROOT_MODE... -> rsync copies each entry; for tar,
# each is emptied and added to $members
prepare() {
  while [ $# -gt 0 ]; do
    if [ "$1" = state ] && [ -n "$keep_tools" ]; then keep=1; else keep=""; fi
    if [ "$mode" = tar ]; then
      if [ -n "$keep" ]; then
        find "$dst/$1" -mindepth 1 -maxdepth 1 ! -name tools -exec rm -rf {} +
      else
        find "$dst/$1" -mindepth 1 -maxdepth 1 -exec rm -rf {} +
      fi
      members="$members ./$1"
    else
      rsync -aH --numeric-ids --delete --chown="$2" ${keep:+--exclude=/tools/} "$src/$1/" "$dst/$1/"
    fi
    shift 4
  done
}
# finish ENTRY OWNER ROOT_OWNER ROOT_MODE... -> each entry itself, its owner and mode
finish() {
  while [ $# -gt 0 ]; do
    chown "$3" "$dst/$1"
    chmod "$4" "$dst/$1"
    shift 4
  done
}
members=""
prepare "$@"
# -P: links to an absolute path or through .. made at once; without it GNU tar
# first writes an empty mode-0 file in their place, which the virtiofs share of
# Colima refuses to open, even to root. restore refused names outside DST.
if [ "$mode" = tar ]; then tar -xzpPf "$src" --numeric-owner -C "$dst" ${keep_tools:+--exclude=./state/tools} $members; fi
finish "$@"'

# has_entry ENTRIES ENTRY -> success when ENTRY is one of the lines of ENTRIES
has_entry() { grep -qxF -- "$2" <<<"$1"; }

# archive_names FILE -> every name in the archive as written: -P, or tar would
# strip a leading / from what it lists
archive_names() { tar -tzPf "$1"; }

# outside_name < NAMES -> the first name that is absolute or goes up with '..',
# which RESTORE_COPY's -P would unpack outside its target; nothing if none
outside_name() { grep -m1 -E '^/|(^|/)\.\.(/|$)' || true; }

# archive_entries < NAMES -> the archive's entries one and two levels down
# (stack.env, state, state/tools, vault...), one per line
archive_entries() {
  awk -F/ '$2 != "" { print $2; if (NF > 2 && $3 != "") print $2 "/" $3 }' | sort -u
}

# The directory restore reads the backup's files into, removed when lolloctl exits.
RESTORE_FILES=

# backup_files KIND BACKUP ENTRIES DIR -> the backup's stack.env, and its
# config.env and platform when it has them, copied into DIR, mode 600; an
# archive is read once
backup_files() {
  local kind=$1 b=$2 entries=$3 dir=$4 e files=()
  for e in stack.env config.env platform; do
    ! has_entry "$entries" "$e" || files+=("$e")
  done
  (
    umask 077
    if [[ $kind == snapshot ]]; then
      cd -- "$b" && cp -- "${files[@]}" "$dir/"
    else
      tar -xzf "$b" -C "$dir" "${files[@]/#/./}"
    fi
  ) || return 1
  for e in "${files[@]}"; do chmod 600 "$dir/$e"; done
}

# backup_stack_name STACK_ENV -> the stack a stack.env is for, from the line
# `add` writes first
backup_stack_name() {
  sed -n '1s/^# Lettuce stack "\([^"]*\)".*/\1/p' "$1"
}

cmd_restore() {
  local usage="usage: lolloctl restore <name> <backup> [--yes]"
  local yes="" args=() name b kind entries dir state f files lock e v owner mode vol keep_tools="" answer
  local emails conf from here me listed src=() mounts=() specs=() names=()
  while (($#)); do
    case $1 in
      --yes) yes=1 ;;
      -*) die "$usage" ;;
      *) args+=("$1") ;;
    esac
    shift
  done
  ((${#args[@]} == 2)) || die "$usage"
  name=${args[0]}
  validate_name "$name"
  [[ -e ${args[1]} ]] || die "${args[1]} does not exist"
  b=$(realpath -- "${args[1]}")
  [[ $b != *[:,]* ]] || die "the backup's path cannot contain ':' or ',': $b"
  # A snapshot directory, or an archive: what `backup` writes in <dir>/<name>/.
  if [[ -d $b ]]; then
    [[ -f $b/stack.env && -d $b/state ]] || die "$b is not a backup: no stack.env and state/ in it"
    kind=snapshot
    require_mounted "$b"
    entries=$(cd "$b" && for e in * state/*; do [[ -e $e ]] && printf '%s\n' "$e"; done)
  elif [[ -f $b && $b == *.tar.gz ]]; then
    kind=archive
    require_mounted "$(dirname -- "$b")"
    listed=$(archive_names "$b") || die "$b: could not read the archive"
    e=$(outside_name <<<"$listed")
    [[ -z $e ]] || die "$b: the archive has an entry that is absolute or goes up with '..': $e; restore unpacks names as written, so it refuses it"
    entries=$(archive_entries <<<"$listed")
    if ! has_entry "$entries" stack.env || ! has_entry "$entries" state; then
      die "$b is not a backup: no stack.env and state/ in it"
    fi
  else
    die "$b is not a backup: name a snapshot directory or a .tar.gz that backup wrote"
  fi
  command -v flock >/dev/null || die "flock is required but not installed (util-linux)"

  # The backup's stack.env and config.env, read before anything here changes.
  files=$(mktemp -d "$LOLLO_DATA/.restore.XXXXXX") || die "could not write in $LOLLO_DATA"
  RESTORE_FILES=$files
  trap 'rm -rf -- "$RESTORE_FILES"' EXIT
  backup_files "$kind" "$b" "$entries" "$files" || die "could not read the backup's stack.env"
  # A stack.env holds its stack's tunnel and Cloudflare ids: under another name,
  # two stacks would share a tunnel, and `remove` of one would delete the other's.
  from=$(backup_stack_name "$files/stack.env")
  [[ -n $from ]] || die "$b/stack.env does not say which stack it belongs to (no '# Lettuce stack \"<name>\"' first line)"
  [[ $from == "$name" ]] ||
    die "$b is a backup of $from, not $name; it holds $from's tunnel and Cloudflare ids, so it can only be restored as $from"

  dir=$(stack_dir "$name")
  state=$dir/state
  f=$(stack_env "$name")
  (umask 077 && mkdir -p "$state")
  chmod 700 "$dir"
  exec {lock}>"$dir/.restore.lock"
  flock -n "$lock" || die "$name: another restore of $name is running"

  # Copying under a stack that has processes, even paused ones, would mix two
  # states; down first, as for an upgrade.
  if [[ -f $f ]] && stack_live "$name"; then
    die "$name is running; stop it first: lolloctl down $name"
  fi
  if [[ -f $f || -n $(ls -A "$state") ]]; then
    if [[ -z $yes ]]; then
      stdin_is_terminal || die "$name already has data here; run with --yes to replace it with the backup"
      info "This replaces $name's data here with $b:"
      info "  $state and $f"
      for e in "${BACKUP_VOLUMES[@]}"; do
        read -r e v _ _ _ <<<"$e"
        ! has_entry "$entries" "$e" || info "  the volume $(stack_volume "$name" "$v")"
      done
      printf 'Type the stack name to confirm: ' >&2
      read -r answer || true
      [[ $answer == "$name" ]] || die "aborted"
    fi
  fi
  build_backup_image || die "could not build $BACKUP_IMAGE (backup/Dockerfile)"

  # The state, as root's (the containers write it as root), with state/ itself
  # yours, as `add` makes it; then the volumes the backup holds. One that does
  # not exist yet is created with Compose's labels, so `up` takes it as the
  # stack's own. One container copies them all.
  me="$(id -u):$(id -g)"
  if ! has_entry "$entries" state/tools; then
    keep_tools=1
    warn "$name: the backup has no agent tools (taken with --no-tools); keeping the ones here"
  elif [[ -f $files/platform ]]; then
    # Agent tools are native programs and modules: another architecture's would
    # fail here with "exec format error".
    from=$(<"$files/platform")
    here=$(host_platform) || die "could not ask Docker for this host's platform"
    if [[ $from != "$here" ]]; then
      keep_tools=1
      warn "$name: the backup comes from a $from host and this one is $here: its agent tools (state/tools) would not run here, so they are left out; agents install what they need again"
    fi
  fi
  mounts=(-v "$state:/r/state")
  specs=(state 0:0 "$me" 700)
  names=(state)
  for e in "${BACKUP_VOLUMES[@]}"; do
    read -r e v owner mode _ <<<"$e"
    has_entry "$entries" "$e" || continue
    vol=$(stack_volume "$name" "$v")
    if ! has_volume "$name" "$v"; then
      host_docker volume create --label "com.docker.compose.project=lollo-$name" \
        --label "com.docker.compose.volume=$v" "$vol" >/dev/null || die "$name: could not create the volume $vol"
    fi
    mounts+=(-v "$vol:/r/$e")
    specs+=("$e" "$owner" "$owner" "$mode")
    names+=("$vol")
  done
  if [[ $kind == snapshot ]]; then
    src=(-v "$b:/b:ro" rsync /b)
  else
    src=(-v "$b:/a.tar.gz:ro" tar /a.tar.gz)
  fi
  info "$name: restoring ${names[*]}"
  host_docker "${BACKUP_RUN[@]}" --label "lolloctl.restore=$name" "${src[@]:0:2}" "${mounts[@]}" "$BACKUP_IMAGE" \
    sh -c "$RESTORE_COPY" sh "${src[@]:2}" /r "$keep_tools" "${specs[@]}" ||
    die "$name: could not restore the backup; its data here is incomplete, so run this restore again"

  # stack.env last, so a failed copy leaves the old one; it names this host's
  # state directory, wherever the backup's host kept it.
  mv -f -- "$files/stack.env" "$f"
  env_set "$f" LETTA_STATE_DIR "$state"

  # config.env only on a host that has none yet: then init picks it up.
  if [[ ! -f $(config_file) && -f $files/config.env ]]; then
    mv -f -- "$files/config.env" "$(config_file)"
    info "config.env: restored from the backup; run lolloctl init next, with a Cloudflare API token for this host"
  fi

  # Who may sign in: the Access policy and ALLOWED_USERS change together (users),
  # and stacks.conf is in step with the policy. A stack it lists keeps the users
  # it admits now; one it lacks gets the backup's, as add would write them.
  emails=$(env_get "$f" ALLOWED_USERS)
  conf=$(conf_entries | awk -v n="$name" '$1 == n { print $2 }')
  if [[ -n $conf && $(email_diff "$emails" "$conf") != "- -" ]]; then
    env_set "$f" ALLOWED_USERS "$conf"
    info "$name: admits $conf, as stacks.conf and the Access policy do, not the backup's $emails"
  elif [[ -z $conf && -n $emails ]]; then
    conf_set "$name" "$emails" || die "could not update stacks.conf"
    info "$name: admits $emails, as in the backup; if its Access policy changed since, run: lolloctl users $name <email>[,<email>]"
  fi
  if [[ -f $(config_file) && $(env_get "$f" COMPOSE_PROFILES) != "$(cfg PROFILES)" ]]; then
    warn "$name: its profiles ($(env_get "$f" COMPOSE_PROFILES)) differ from config.env's PROFILES ($(cfg PROFILES)); up will refuse it until they match (lolloctl profiles)"
  fi
  ! has_entry "$entries" google-creds || info "$name: the Google tokens are back; nobody needs to reconnect Google"
  info "$name: restored from $b; start it with: lolloctl up $name && lolloctl skills $name"
}

cmd_receipts() {
  local usage="usage: lolloctl receipts <name> [<file.html> [<session>]]"
  local name=${1:-} report=${2:-} session=${3:-} sessions t s tmp
  [[ -n $name && $# -le 3 ]] || die "$usage"
  validate_name "$name"
  require_stack "$name"
  has_receipts "$name" || die "$name: no pipelock receipts (its volume $(receipts_volume "$name") does not exist)"
  pipelock_setup "$name"
  sessions=$(receipt_sessions "$name") || die "$name: could not list the receipts"
  [[ -n $sessions ]] || die "$name: pipelock has written no receipts yet"
  if [[ -z $report ]]; then
    receipts_verify "$name"
    info "sessions (one per start of pipelock), newest first:"
    while read -r t s; do
      printf '%s  %s\n' "$(date -d "@$t" '+%F %T')" "$s"
    done <<<"$sessions"
    return 0
  fi
  if [[ -z $session ]]; then
    session=$(head -n 1 <<<"$sessions" | cut -d' ' -f2)
  else
    awk -v s="$session" '$2 == s { f = 1 } END { exit !f }' <<<"$sessions" || die "$name: no session $session"
  fi
  [[ -d $(dirname -- "$report") ]] || die "$(dirname -- "$report") is not a directory"
  # A clone is public, and receipts name every site the agents reached.
  ! inside "$report" "$LOLLO_HOME" || die "the report cannot be inside $LOLLO_HOME"
  ! inside "$report" "$LOLLO_DATA" || die "the report cannot be inside $LOLLO_DATA"
  require_mounted "$(dirname -- "$(realpath -m -- "$report")")"
  # Written beside it (mktemp makes it 600) and renamed: an existing file
  # takes the new mode, and survives a failure.
  tmp=$(mktemp "$(dirname -- "$report")/.receipts.XXXXXX") || die "could not write in $(dirname -- "$report")"
  if ! pipelock_run pipelock evidence view --receipt-dir /data/evidence \
    --session "$session" --trusted-signer "file=$PIPELOCK_KEY_PUB" >"$tmp" || ! mv -f -- "$tmp" "$report"; then
    rm -f -- "$tmp"
    die "$name: could not write the report"
  fi
  info "$name: session $session -> $report"
}

cmd_skills() {
  (($# == 1)) || die "usage: lolloctl skills <name|all>"
  local n targets k
  targets=$(expand_targets "$1")
  for n in $targets; do
    # Before lollo's skills are replaced, so a changed one is seen.
    audit_summary "$n"
    # Explicit: apply and _after-upgrade call this behind `||`, where set -e is off.
    k=$(sync_skills "$n") || return 1
    info "$n: $k skill(s) installed"
  done
}

cmd_mcp() {
  (($# == 1)) || [[ $# == 2 && $2 == --force ]] || die "usage: lolloctl mcp <name|all> [--force]"
  local n targets groups failed=()
  require_initialised
  mapfile -t groups < <(mcp_groups "$(cfg PROFILES)")
  ((${#groups[@]})) ||
    die "the lollo-doc-tools, lollo-vault, lollo-news-radar and lollo-browser profiles are all off; turn one on first, e.g.: lolloctl profiles $(cfg PROFILES),lollo-doc-tools"
  targets=$(expand_targets "$1")
  for n in $targets; do
    register_mcp "$n" "${2:-}" "${groups[@]}" || failed+=("$n")
  done
  ((${#failed[@]} == 0)) ||
    die "could not register the MCP servers in: ${failed[*]}; see the messages above (is the stack up?), then run: lolloctl mcp <name>"
}

# ── releases ─────────────────────────────────────────────────────────────────
# Run by the wrapper (release/lolloctl-wrapper.sh) for `self-upgrade`; not for
# operators.

# cmd__fetch_wrapper TAG -> downloads release TAG's wrapper and SHA256SUMS into
# bin/.lolloctl.new and checks the sum. The sum comes from the same release,
# so it catches a broken download, not a forged release: the attestation does
# that (gh attestation verify). A dev build has no release: fetch_dev_wrapper.
cmd__fetch_wrapper() {
  (($# == 1)) && [[ $1 =~ ^v[0-9]+\.[0-9]+\.[0-9]+(-rc\.[0-9]+|-dev\.[a-z0-9-]+\.[0-9]+)?$ ]] ||
    die "usage: lolloctl self-upgrade vX.Y.Z (or vX.Y.Z-rc.N, or a dev build's vX.Y.Z-dev.<slug>.<N>)"
  release_mode || die "self-upgrade is for a released lolloctl; from a clone, git pull"
  if [[ $1 == *-dev.* ]]; then
    fetch_dev_wrapper "$1"
    return
  fi
  local url bin sums want got
  url=https://github.com/$(release_get REPOSITORY)/releases/download/$1
  bin=$LOLLO_DATA/bin
  sums=$(curl -fsSL --proto '=https' "$url/SHA256SUMS" </dev/null) || die "no release $1 at $url"
  want=$(awk '$2 == "lolloctl" || $2 == "*lolloctl" { print $1 }' <<<"$sums")
  [[ $want =~ ^[0-9a-f]{64}$ ]] || die "release $1's SHA256SUMS has no lolloctl"
  curl -fsSL --proto '=https' -o "$bin/.lolloctl.new" "$url/lolloctl" </dev/null || die "could not download release $1's wrapper"
  got=$(sha256sum "$bin/.lolloctl.new" | cut -d' ' -f1)
  [[ $got == "$want" ]] || {
    rm -f "$bin/.lolloctl.new"
    die "release $1's wrapper does not match its SHA256SUMS"
  }
  chmod 755 "$bin/.lolloctl.new"
}

# fetch_dev_wrapper TAG -> writes dev build TAG's wrapper into bin/.lolloctl.new.
# A dev build is only the lolloctl image's tag (publish.yml, release/README.md
# "Dev builds"), from this release's own repository: it pulls that image, pins
# its digest, checks that its RELEASE is TAG's, and fills the wrapper template
# the image carries, as publish.yml fills a release's.
fetch_dev_wrapper() {
  local tag=$1 repo name digest ref version template bin=$LOLLO_DATA/bin
  repo=$(release_get REPOSITORY)
  name=ghcr.io/${repo%%/*}/lolloctl
  name=${name,,}
  host_docker pull -q "$name:$tag" </dev/null >/dev/null || die "no dev build $tag at $name"
  digest=$(host_docker image inspect --format '{{json .RepoDigests}}' "$name:$tag" </dev/null |
    jq -r --arg n "$name@" '.[] | select(startswith($n)) | ltrimstr($n)' | head -1) || true
  [[ $digest =~ ^sha256:[0-9a-f]{64}$ ]] || die "could not read the digest of $name:$tag"
  ref=$name:$tag@$digest
  # Every lolloctl image keeps the code where this one does, LOLLO_HOME.
  version=$(host_docker run --rm --entrypoint cat "$ref" "$LOLLO_HOME/RELEASE" </dev/null | sed -n 's/^VERSION=//p') || true
  [[ $version == "${tag#v}" ]] || die "$ref is not dev build $tag (its RELEASE says ${version:-nothing})"
  template=$(host_docker run --rm --entrypoint cat "$ref" "$LOLLO_HOME/release/lolloctl-wrapper.sh" </dev/null) ||
    die "$ref carries no wrapper"
  printf '%s\n' "$template" | sed -e "s|@VERSION@|$tag|" -e "s|@IMAGE@|$ref|" -e "s|@REPOSITORY@|$repo|" >"$bin/.lolloctl.new"
  if [[ ! -s $bin/.lolloctl.new ]] || grep -q '@[A-Z]*@' "$bin/.lolloctl.new"; then
    rm -f "$bin/.lolloctl.new"
    die "$ref's wrapper template could not be filled in"
  fi
  chmod 755 "$bin/.lolloctl.new"
}

# cmd__after_upgrade -> run by the new wrapper once it is in place: moves Lettuce
# forward to the tag this release was tested with (never back: an older
# letta-code may not read what a newer one wrote), else updates every stack;
# then installs the release's agent skills in every stack, once they are up
cmd__after_upgrade() {
  local tested
  [[ -f $(config_file) ]] || return 0
  tested=$(release_get LETTUCE_REF)
  info "lollo-rozzo $(release_get VERSION)"
  if [[ $tested != "$(cfg LETTUCE_REF)" ]] && version_ge "$tested" "$(cfg LETTUCE_REF)"; then
    cmd_upgrade "$tested"
  else
    warn_untested_ref
    cmd_up all
  fi
  (cmd_skills all) ||
    die "lollo-rozzo $(release_get VERSION) is in place, but its agent skills are not installed in every stack; fix the cause, then run: lolloctl skills all"
}

cmd_version() {
  if release_mode; then
    printf 'lollo-rozzo %s (Lettuce %s tested)\n' "$(release_get VERSION)" "$(release_get LETTUCE_REF)"
  else
    printf 'lollo-rozzo from a clone: %s\n' "$LOLLO_HOME"
  fi
  # backup and restore copy with it.
  printf 'backup image: %s\n' "$BACKUP_IMAGE"
}

main() {
  local cmd=${1:-help}
  shift || true
  case $cmd in
    help | -h | --help)
      usage
      return
      ;;
    # Before there is any data: docs/cloudflare-setup.md, step 2.6.
    dns-preflight) exec "$LOLLO_HOME/scripts/dns-preflight.sh" "$@" ;;
  esac
  resolve_data_dir
  check_mounts
  BACKUP_IMAGE=$(image_name backup)
  PIPELOCK_IMAGE=$(image_name pipelock)
  case $cmd in
    init | apply | add | users | remove | profiles | upgrade | up | down | restart | check | status | audit | list | logs | compose | shell | toolbox | skills | mcp | backup | restore | receipts | version)
      "cmd_$cmd" "$@"
      ;;
    _fetch-wrapper) cmd__fetch_wrapper "$@" ;;
    _after-upgrade) cmd__after_upgrade "$@" ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
