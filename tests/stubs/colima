#!/usr/bin/env bash
# Test stub for colima: logs "colima <args>" to $STUB_ROOT/calls.log.
# `colima ssh-config --profile P` prints an ssh config for the host colima (or
# colima-P), or fails with STUB_COLIMA_RC. Tests copy the stubs to $STUB_ROOT/bin.
STUB_ROOT=$(cd "$(dirname "$0")/.." && pwd)
# shellcheck source=/dev/null
[[ -f $STUB_ROOT/stub.env ]] && . "$STUB_ROOT/stub.env"
printf 'colima %s\n' "$*" >>"$STUB_ROOT/calls.log"
[[ ${STUB_COLIMA_RC:-0} == 0 ]] || exit "$STUB_COLIMA_RC"
if [[ ${1:-} == ssh-config ]]; then
  profile=${3:-default}
  host=colima
  [[ $profile == default ]] || host=colima-$profile
  printf 'Host %s\n  HostName 127.0.0.1\n  Port 50022\n' "$host"
fi
